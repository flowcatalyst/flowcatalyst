{
	"name": "@flowcatalyst/platform-frontend",
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"dev": "vite",
		"dev:full": "concurrently -k -n go,vite -c blue,green \"cd .. && FC_API_PORT=${FC_API_PORT:-8080} make dev\" \"wait-on tcp:${FC_API_PORT:-8080} && VITE_BACKEND_PORT=${FC_API_PORT:-8080} vite\"",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"api:generate": "openapi-ts",
		"api:generate:live": "OPENAPI_LIVE=true openapi-ts",
		"lint": "oxlint .",
		"format": "oxfmt --write .",
		"test": "vitest",
		"test:ui": "vitest --ui"
	},
	"dependencies": {
		"@primeuix/themes": "^2.0.3",
		"@primevue/core": "^4.5.5",
		"@simplewebauthn/browser": "^14.0.0",
		"@vee-validate/zod": "^4.15.1",
		"@vue/devtools-api": "^8.2.1",
		"dompurify": "^3.4.14",
		"fflate": "^0.8.2",
		"marked": "^18.2.0",
		"mermaid": "^12.3.0",
		"pinia": "^4.1.0",
		"primeicons": "^7.0.0",
		"primevue": "^4.5.5",
		"swagger-ui-dist": "^5.35.0",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.13",
		"vue-router": "^5.5.1",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@flowcatalyst/schema-codegen": "file:packages/schema-codegen",
		"@hey-api/openapi-ts": "^0.99.0",
		"@primevue/auto-import-resolver": "^4.5.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vitest/ui": "^5.1.0",
		"chokidar": "^6.0.0",
		"concurrently": "^10.0.7",
		"jsdom": "^31.0.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"typescript": "~6.0.3",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vue-tsc": "3.3.11",
		"wait-on": "^9.5.1"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
