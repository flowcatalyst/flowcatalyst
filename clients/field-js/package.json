{
	"name": "@flowcatalyst/field-js",
	"version": "0.0.0",
	"description": "Browser / WebView library for FlowCatalyst field workers: device enrolment and PIN sign-in",
	"keywords": [
		"flowcatalyst",
		"field-worker",
		"dpop",
		"pin"
	],
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/yourusername/flowcatalyst.git",
		"directory": "clients/field-js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"test": "node --import tsx --test --test-reporter=spec 'tests/unit/**/*.test.ts'",
		"test:e2e": "node --import tsx --test --test-reporter=spec 'e2e/**/*.e2e.ts'",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"fake-indexeddb": "^6.0.0",
		"happy-dom": "^18.0.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.0"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
