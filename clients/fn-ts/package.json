{
  "name": "@flowcatalyst/fn",
  "version": "0.1.0",
  "description": "FlowCatalyst guest SDK for JavaScript/TypeScript functions, running on the function runner's shared QuickJS engine (docs/function-runner-plan.md \u00a72.2/\u00a79).",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "fc-fn-build": "./bin/fc-fn-build.js"
  },
  "scripts": {
    "build": "node bin/fc-fn-build.js",
    "build:hello": "node bin/fc-fn-build.js examples/hello/src/index.ts --outfile examples/hello/dist/function.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
