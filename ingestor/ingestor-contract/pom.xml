<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flowcatalyst.ingestor</groupId>
    <artifactId>ingestor-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>ingestor-contract</artifactId>
  <!-- The API's version, not the runtime's: see the parent's ingestor-api.version. -->
  <version>${ingestor-api.version}</version>
  <name>ingestor-contract</name>
  <description>The wire contract between the ingestor runtime and the platform's ingestion runtime API.</description>

  <dependencies>
    <!-- For the type discriminators on the sealed types, and a custom source's settings. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- CamelRoutes reads a camel-route source's YAML. -->
    <dependency>
      <groupId>org.snakeyaml</groupId>
      <artifactId>snakeyaml-engine</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- The installed POM carries the version itself (1.0.0), not ${ingestor-api.version}, which the
           parent's flatten mode (CI-friendly properties only) would leave as it is. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <pomElements>
            <version>resolve</version>
          </pomElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
