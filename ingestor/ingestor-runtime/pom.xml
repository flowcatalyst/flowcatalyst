<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.flowcatalyst.ingestor</groupId>
    <artifactId>ingestor-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>ingestor-runtime</artifactId>
  <name>ingestor-runtime</name>
  <description>Runs the platform's ingestions as Apache Camel routes, creates their dispatch jobs through the platform's runtime API, and reports on them.</description>

  <dependencies>
    <dependency>
      <groupId>io.flowcatalyst.ingestor</groupId>
      <artifactId>ingestor-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.ingestor</groupId>
      <artifactId>ingestor-extension</artifactId>
    </dependency>
    <!-- Checks platform access tokens presented to HTTP ingestions. -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-auth</artifactId>
    </dependency>
    <!-- Config, lifecycle and the health endpoints. -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-http-jetty</artifactId>
    </dependency>

    <!-- Calls to the platform's runtime API. -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-httpclient-module</artifactId>
    </dependency>

    <!-- The platform client: its service-account token carries every runtime call. -->
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-flowcatalyst</artifactId>
    </dependency>

    <!--
      Camel, component by component: what is listed here is what an ingestion can use. Add a
      source's component in the same change that builds its endpoint in CamelSourceEndpoints.
    -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-core-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-core-languages</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-direct</artifactId>
    </dependency>
    <!-- The sftp source. -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-ftp</artifactId>
    </dependency>

    <!-- The sqs and s3 sources. -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-aws2-sqs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-aws2-s3</artifactId>
    </dependency>
    <!-- Also read directly: the pinned extension manifest and its jars are fetched from S3. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <!-- Camel's s3 component leaves the async Netty client out; the sync client is all that is used here. -->
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      The camel-route source: Camel's YAML DSL, and the components a route is likely to start from
      or call that no built-in source brings: timer, http and log.
    -->
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-yaml-dsl</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-timer</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-http</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-log</artifactId>
    </dependency>
    <!-- The rabbitmq source: the plain client, consumed by RabbitMqEndpoint. Camel's own component needs Spring. -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
    </dependency>

    <!-- An application chooses its logging backend; libraries bring none. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- The worked-example extension, loaded from the class path by the extension tests. -->
    <dependency>
      <groupId>io.flowcatalyst.ingestor</groupId>
      <artifactId>ingestor-extension-generator</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real servers for the sources' tests: SFTP, RabbitMQ, a local AWS, PostgreSQL. They skip when Docker is not there. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-auth</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.flowcatalyst.framework</groupId>
      <artifactId>framework-database</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Camel's threads virtual in every test, as RuntimeModule makes them when the runtime starts:
           tests that build a Camel context of their own do so before any RuntimeModule registers. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dcamel.threads.virtual.enabled=true</argLine>
        </configuration>
      </plugin>
      <!--
        The fat jar the release attaches and the image runs: java -jar ingestor-runtime-X.Y.Z-all.jar.
        Camel finds its components through META-INF/services files, which are merged.
      -->
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.flowcatalyst.ingestor.runtime.IngestRuntime</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
