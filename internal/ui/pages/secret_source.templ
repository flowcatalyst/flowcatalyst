package pages

import "github.com/flowcatalyst/framework/go/ui/kit"

// secretSource is a secret's value control: where the value comes from (the
// "Stored as" choice) and the value, or the reference to the parameter or
// secret in AWS that holds it. Only the chosen part is shown; the server reads
// the part the choice names (secretSourcePosted).
templ secretSource(p secretSourceProps) {
	<div class="flex flex-col gap-2" id={ p.ID + "-wrap" } data-signals={ p.initSignals() }>
		@kit.Select(kit.SelectProps{ID: p.ID + "-source", Name: p.Name + "Source", Options: secretSourceOptions, Selected: p.source(), Attrs: templ.Attributes{p.bindAttr(): true, "aria-label": "Stored as"}})
		<div data-show={ p.showWhen(secretSourceValue) } style={ hiddenUnless(p.source() == secretSourceValue) }>
			@kit.PasswordInput(kit.PasswordInputProps{ID: p.ID, Name: p.Name, Signal: p.Signal, Placeholder: p.ValuePlaceholder, Invalid: p.Invalid && p.source() == secretSourceValue, DescribedBy: p.DescribedBy})
			<p class="mt-1 text-sm text-muted-foreground">Stored encrypted and never shown again.</p>
		</div>
		<div data-show={ p.showWhen(secretSourcePS) } style={ hiddenUnless(p.source() == secretSourcePS) }>
			@secretSourceRef(p, secretSourcePS, "/path/to/parameter")
			<p class="mt-1 text-sm text-muted-foreground">The parameter's name, for example <code>/shared/partner/client-secret</code>. The platform reads it from Parameter Store when it hands the secret out, so a change made in AWS reaches every function and ingestion that uses it within 5 minutes.</p>
		</div>
		<div data-show={ p.showWhen(secretSourceSM) } style={ hiddenUnless(p.source() == secretSourceSM) }>
			@secretSourceRef(p, secretSourceSM, "secret-name")
			<p class="mt-1 text-sm text-muted-foreground">The secret's name or ARN. For a JSON secret, add <code>#key</code> to take one of its keys, for example <code>shared/partner#client_secret</code>. The platform reads it from Secrets Manager when it hands the secret out.</p>
		</div>
	</div>
}

// secretSourceRef is the reference's path, after the store's scheme. Each
// store's input has its own name (secretSourceRefName), so the hidden one's
// text is posted and ignored.
templ secretSourceRef(p secretSourceProps, source, placeholder string) {
	<div class="flex items-center gap-2">
		<span class="shrink-0 whitespace-nowrap font-mono text-sm text-muted-foreground" aria-hidden="true">{ secretSourceScheme(source) }</span>
		@kit.Input(kit.InputProps{ID: p.ID + "-" + source, Name: secretSourceRefName(p.Name, source), Value: p.refFor(source), Placeholder: placeholder, Class: "font-mono", Invalid: p.Invalid && p.source() == source, DescribedBy: p.DescribedBy, Attrs: templ.Attributes{"autocomplete": "off", "autocapitalize": "off", "spellcheck": "false", "aria-label": secretSourceRefLabel(source)}})
	</div>
}

func secretSourceRefLabel(source string) string {
	if source == secretSourcePS {
		return "Parameter name"
	}
	return "Secret name or ARN"
}

// secretReference shows a stored reference where a secret value is masked: the
// store, then the reference (a reference is not a secret).
templ secretReference(ref, testID string) {
	<span class="text-muted-foreground" data-testid={ testID }>{ secretSourceLabel(ref) }: <code class="text-foreground">{ ref }</code></span>
}

func secretSourceLabel(ref string) string {
	source, _ := secretSourceOf(ref)
	for _, o := range secretSourceOptions {
		if o.Value == source && source != secretSourceValue {
			return o.Label
		}
	}
	return "Reference"
}
