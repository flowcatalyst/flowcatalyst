package pages

import (
	"strconv"

	"github.com/flowcatalyst/flowcatalyst-go/internal/platform/fieldidentity"

	"github.com/flowcatalyst/framework/go/ui/kit"
)

templ fieldPolicyPage(v fieldPolicyView) {
	@kit.PageHeader(kit.PageHeaderProps{
		Title:    "Field Policy",
		Subtitle: "The PIN, lock-out and session rules of a client's field workers. A client with no policy of its own uses the platform defaults.",
	})
	<div class="mb-4">
		@kit.SearchSelect(v.clientSelect())
	</div>
	@fieldPolicyBody(v)
}

// fieldPolicyBody is what a save patches: the state tag and the form, with
// the values as saved (or as submitted when the save was refused).
templ fieldPolicyBody(v fieldPolicyView) {
	<div id={ fieldPolicyRegion }>
		if v.Client == "" {
			@kit.EmptyState(kit.EmptyStateProps{Message: "Select a client to view its field policy."})
		} else {
			<div class="mb-4 flex flex-wrap items-center gap-2">
				if v.Policy.IsDefault {
					<span title="This client has no policy of its own: the platform defaults apply. Saving creates one.">
						@kit.Tag(kit.TagProps{Severity: kit.TagInfo, Label: "Default"})
					</span>
					<span class="text-sm text-muted-foreground">The platform defaults apply to { v.ClientName }.</span>
				} else {
					@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "Custom"})
					<span class="text-sm text-muted-foreground">
						Set for { v.ClientName }, last updated{ " " }
						@kit.LocalTime(kit.LocalTimeProps{At: v.UpdatedAt, Empty: "—"})
					</span>
				}
			</div>
			<form id={ fieldPolicyForm } method="post" action={ fieldPolicyPath } data-on:submit={ kit.SubmitForm } style="max-width:44rem">
				<input type="hidden" name="client" value={ v.Client }/>
				if v.Errs.Form != "" {
					@kit.Alert(kit.AlertProps{Variant: kit.AlertDestructive, Icon: "circle-alert", Description: v.Errs.Form, Class: "mb-4"})
				}
				@kit.FormSection(kit.FormSectionProps{Title: "PIN and lock-out"}) {
					<div class="flex flex-col gap-4">
						for _, f := range policyFields[:4] {
							@policyInput(v, f)
						}
					</div>
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Sessions"}) {
					<div class="flex flex-col gap-4">
						for _, f := range policyFields[4:8] {
							@policyInput(v, f)
						}
					</div>
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Devices"}) {
					@kit.Field(kit.FieldProps{Label: "Require device attestation", For: "field-policy-requireAttestation", Description: "Refuse devices that cannot prove their key is hardware-backed."}) {
						@kit.Switch(kit.SwitchProps{ID: "field-policy-requireAttestation", Name: "requireAttestation", Value: "1", Checked: v.Attestation, Disabled: !v.CanManage})
					}
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Sign-in options"}) {
					<div class="flex flex-col gap-4">
						@kit.Field(kit.FieldProps{Label: "Require an enrolled device", For: "field-policy-" + policyRequireEnrolled, Description: "Off by default: a worker can sign in with a worker code and PIN, or a badge, from any device. On: only enrolled devices can sign in, and anything else is refused as an unknown device."}) {
							@kit.Switch(kit.SwitchProps{ID: "field-policy-" + policyRequireEnrolled, Name: policyRequireEnrolled, Value: "1", Checked: v.RequireEnroll, Disabled: !v.CanManage})
						}
						@policyInput(v, policyFieldByKey("unenrolledIdleSecs"))
						@kit.Field(kit.FieldProps{Label: "Badge-only sign-in", For: "field-policy-" + policyBadgeOnly, Description: "Let a badge sign in without a PIN. Only on an enrolled device, and never when the device is not enrolled: a photocopied badge must not work from any phone."}) {
							@kit.Switch(kit.SwitchProps{ID: "field-policy-" + policyBadgeOnly, Name: policyBadgeOnly, Value: "1", Checked: v.BadgeOnly, Disabled: !v.CanManage})
						}
						@policyInput(v, policyFieldByKey("impersonationMaxSecs"))
					</div>
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Unlock keys"}) {
					<div class="flex flex-col gap-4">
						@kit.Field(kit.FieldProps{Label: "Sign in again with a fingerprint or face", For: "field-policy-" + policyUnlockKeys, Description: "Off by default. On: after signing in with their PIN on their own (personal, enrolled) phone, a worker can set up an unlock key and later sign in there with a fingerprint or face. Never on a shared device. Switching it off revokes every unlock key of this client."}) {
							@kit.Switch(kit.SwitchProps{ID: "field-policy-" + policyUnlockKeys, Name: policyUnlockKeys, Value: "1", Checked: v.UnlockKeys, Disabled: !v.CanManage})
						}
						@kit.Field(kit.FieldProps{Label: "Require a trusted hardware attestation", For: "field-policy-" + policyUnlockAttest, Description: "Off by default: each key's attestation is recorded and shown, not enforced. On: only a key that a trusted Android attestation shows is in secure hardware and needs a strong biometric for every use can be set up (an iPhone has no such attestation). Switching it on revokes the keys that do not meet it.", Error: v.Errs.Fields[policyUnlockAttest], ErrorID: "field-policy-" + policyUnlockAttest + "-err"}) {
							if v.AttestBlocked {
								@kit.Switch(kit.SwitchProps{ID: "field-policy-" + policyUnlockAttest, Name: policyUnlockAttest, Value: "REQUIRED", Checked: v.UnlockAttest, Disabled: true,
									Attrs: templ.Attributes{"title": noRootsReason, "aria-describedby": "field-policy-" + policyUnlockAttest + "-blocked"}})
							} else {
								@kit.Switch(kit.SwitchProps{ID: "field-policy-" + policyUnlockAttest, Name: policyUnlockAttest, Value: "REQUIRED", Checked: v.UnlockAttest, Disabled: !v.CanManage})
							}
						}
						if v.AttestNote != "" {
							if v.AttestWarn && v.UnlockAttest {
								@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: v.AttestNote})
							} else {
								<p class="m-0 text-sm text-muted-foreground" id={ "field-policy-" + policyUnlockAttest + "-blocked" }>{ v.AttestNote }</p>
							}
						}
					</div>
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Worker codes"}) {
					@policyInput(v, policyFieldByKey("workerCodeDigits"))
				}
				if v.CanManage {
					<div class="mt-4 flex justify-end gap-2">
						@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Icon: "check"}) {
							Save policy
						}
					</div>
				} else {
					<p class="mt-4 text-sm text-muted-foreground">You can view this policy but not change it.</p>
				}
			</form>
			@fieldPolicyOverrides(v)
			@fieldPolicyPhotos(v)
		}
	</div>
}

// fieldPolicyPhotos is the client's two photo settings, a form of its own so
// that saving it never sends the rest of the policy (and the question before
// deleting photos has one thing to ask about).
templ fieldPolicyPhotos(v fieldPolicyView) {
	if v.PhotosShown {
		<form id={ fieldPhotosForm } method="post" action={ fieldPolicyPath + "/photos" } data-on:submit={ kit.SubmitForm } class="mt-4" style="max-width:44rem">
			<input type="hidden" name="client" value={ v.Client }/>
			@kit.FormSection(kit.FormSectionProps{Title: "Worker photos"}) {
				<div class="flex flex-col gap-4">
					@kit.Field(kit.FieldProps{Label: "Photos for this client", For: "field-policy-photosEnabled", Description: "On: workers can have a photo, shown to the people who manage and work with them. Off: no photo can be set and none is shown."}) {
						@kit.Switch(kit.SwitchProps{ID: "field-policy-photosEnabled", Name: "photosEnabled", Value: "1", Checked: v.PhotosOn, Disabled: !v.CanManage})
					}
					@kit.Field(kit.FieldProps{Label: "Workers may set their own photo", For: "field-policy-workerMaySetOwnPhoto", Description: "Off by default. On: a signed-in worker can set, replace and remove their own photo from their device."}) {
						@kit.Switch(kit.SwitchProps{ID: "field-policy-workerMaySetOwnPhoto", Name: "workerMaySetOwnPhoto", Value: "1", Checked: v.OwnPhoto, Disabled: !v.CanManage})
					}
					<p class="m-0 text-sm text-muted-foreground">Switching photos off hides them and keeps them: they come back when photos are switched on again. Only Delete all photos, below, deletes them.</p>
					if !v.PhotosOn {
						<p class="m-0 text-sm text-muted-foreground">Photos are off for this client, so the setting above has no effect until they are switched on.</p>
					}
				</div>
			}
			if v.CanManage {
				<div class="mt-4 flex justify-end gap-2">
					@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Icon: "check"}) {
						Save photo settings
					}
				</div>
			}
		</form>
		@fieldPolicyPhotoDelete(v)
	}
}

// fieldPolicyPhotoDelete is "Delete all photos": its own action, in the
// console's destructive style (a red item of its own, then a question that
// names the count and says it cannot be undone), offered whether photos are on
// or off. With nothing stored the button is disabled and says why.
templ fieldPolicyPhotoDelete(v fieldPolicyView) {
	if v.CanDeletePhotos {
		<div class="fc-danger-item mt-4" style="max-width:44rem">
			<div>
				<strong>Delete all photos</strong>
				if v.PhotoCount == 0 {
					<p>{ v.ClientName } has no stored photos to delete.</p>
				} else {
					<p>Delete the { photoCountNoun(v.PhotoCount) } stored for { v.ClientName }'s workers, whether photos are on or off. This cannot be undone.</p>
				}
			</div>
			@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "trash-2", Disabled: v.PhotoCount == 0, Attrs: confirmTrigger(fieldPhotosDelDlg, fieldPolicyPath+"/photos/delete")}) {
				Delete all photos
			}
		</div>
		if v.PhotoCount > 0 {
			@kit.ConfirmDialog(kit.ConfirmDialogProps{
				ID: fieldPhotosDelDlg, Action: fieldPolicyPath + "/photos/delete", Title: "Delete all photos for " + v.ClientName + "?",
				Message:      "This deletes the " + photoCountNoun(v.PhotoCount) + " stored for " + v.ClientName + "'s workers. This can't be undone.",
				ConfirmLabel: "Delete " + photoCountNoun(v.PhotoCount), Tone: kit.ToneDanger,
				Hidden:    []kit.HiddenField{{Name: "client", Value: v.Client}},
				FormAttrs: templ.Attributes{"data-on:submit": kit.SubmitConfirm},
			})
		}
	}
}

templ policyInput(v fieldPolicyView, f policyField) {
	@kit.Field(kit.FieldProps{
		Label: f.Label, For: "field-policy-" + f.Key, Description: f.Help, Error: v.Errs.Fields[f.Key], ErrorID: "field-policy-" + f.Key + "-err",
	}) {
		<div class="flex items-center gap-2">
			@kit.Input(kit.InputProps{
				ID: "field-policy-" + f.Key, Name: f.Key, Type: "number", Value: v.Values[f.Key], Disabled: !v.CanManage,
				Invalid: v.Errs.Fields[f.Key] != "", DescribedBy: policyDescribedBy(v, f), Class: "w-40",
				Attrs: templ.Attributes{"min": strconv.Itoa(f.Min), "max": strconv.Itoa(f.Max), "step": "1", "inputmode": "numeric"},
			})
			<span class="text-sm text-muted-foreground">{ f.Unit }</span>
		</div>
	}
}

func policyDescribedBy(v fieldPolicyView, f policyField) string {
	if v.Errs.Fields[f.Key] != "" {
		return "field-policy-" + f.Key + "-err"
	}
	return ""
}

// fieldPolicyOverrides is the applications' overrides of this policy
// (docs/field-policy-application-overrides.md section 5): each application's
// override with Clear, a form that sets or clears one member for an
// application, and, for a platform administrator, the members applications may
// not override.
templ fieldPolicyOverrides(v fieldPolicyView) {
	<div class="mt-4" style="max-width:44rem">
		@kit.FormSection(kit.FormSectionProps{Title: "Application overrides"}) {
			<div class="flex flex-col gap-4">
				<p class="m-0 text-sm text-muted-foreground">An application can override some of these settings for its own sessions, on or off whatever the client has. The client's value is the default for every application that follows it.</p>
				if v.Overrides.Error != "" {
					@kit.Alert(kit.AlertProps{Variant: kit.AlertDestructive, Icon: "circle-alert", Description: v.Overrides.Error})
				}
				if len(v.Overrides.Rows) == 0 {
					<p class="m-0 text-sm text-muted-foreground">No application overrides this policy: every application follows it.</p>
				} else {
					for _, row := range v.Overrides.Rows {
						<div class="fc-detail-grid">
							@kit.DetailField(kit.DetailFieldProps{Label: "Application"}) {
								{ row.AppName } <code>{ row.AppCode }</code>
							}
							@kit.DetailField(kit.DetailFieldProps{Label: "Overrides"}) {
								<ul class="m-0 pl-4">
									for _, it := range row.Items {
										<li>{ it }</li>
									}
								</ul>
							}
						</div>
						if v.Overrides.CanOverride {
							<div>
								@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "rotate-ccw", Attrs: confirmTrigger(row.ClearDialog, fieldPolicyPath+"/overrides/clear")}) {
									Clear override
								}
							</div>
							@kit.ConfirmDialog(kit.ConfirmDialogProps{
								ID: row.ClearDialog, Action: fieldPolicyPath + "/overrides/clear", Title: "Clear " + row.AppName + "'s override?",
								Message:      "Every setting it overrides follows the client's policy again. Its sessions signed in with an unlock key end if that turns unlock keys off for it.",
								ConfirmLabel: "Clear override", Tone: kit.ToneWarn,
								Hidden:    []kit.HiddenField{{Name: "client", Value: v.Client}, {Name: "application", Value: row.AppID}},
								FormAttrs: templ.Attributes{"data-on:submit": kit.SubmitConfirm},
							})
						}
					}
				}
				if v.Overrides.CanOverride && len(v.Overrides.AppOptions) > 0 {
					<form id={ fieldOverrideForm } method="post" action={ fieldPolicyPath + "/overrides" } data-on:submit={ kit.SubmitForm } class="flex flex-col gap-4">
						<input type="hidden" name="client" value={ v.Client }/>
						@kit.Field(kit.FieldProps{Label: "Application", For: "field-override-application"}) {
							@kit.Select(kit.SelectProps{ID: "field-override-application", Name: "application", Options: v.Overrides.AppOptions, Placeholder: "Choose an application"})
						}
						@kit.Field(kit.FieldProps{Label: "Setting", For: "field-override-member", Description: "A setting the client has locked cannot be overridden."}) {
							@kit.Select(kit.SelectProps{ID: "field-override-member", Name: "member", Options: v.Overrides.memberOptions()})
						}
						@kit.Field(kit.FieldProps{Label: "For this application", For: "field-override-setting"}) {
							@kit.Select(kit.SelectProps{ID: "field-override-setting", Name: "setting", Options: overrideSettingOptions()})
						}
						@kit.Field(kit.FieldProps{Label: "Seconds", For: "field-override-seconds", Description: "For a limit only: within the same range as the client's (idle 60 to 86400, shift 3600 to 86400)."}) {
							@kit.Input(kit.InputProps{ID: "field-override-seconds", Name: "seconds", Type: "number", Class: "w-40", Attrs: templ.Attributes{"min": "60", "max": "86400", "step": "1", "inputmode": "numeric"}})
						}
						<div class="flex justify-end">
							@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Icon: "check"}) {
								Save override
							}
						</div>
					</form>
				}
			</div>
		}
		if v.Overrides.CanLock {
			<form id={ fieldLocksForm } method="post" action={ fieldPolicyPath + "/locks" } data-on:submit={ kit.SubmitForm } class="mt-4">
				<input type="hidden" name="client" value={ v.Client }/>
				if v.Overrides.ConfirmRevoke {
					<input type="hidden" name="confirmRevoke" value="1"/>
				}
				@kit.FormSection(kit.FormSectionProps{Title: "Locked for applications"}) {
					<div class="flex flex-col gap-2">
						if v.Overrides.ConfirmRevoke {
							@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: "Nothing is saved yet. With these locks no application of this client keeps fingerprint sign-in on: saving revokes every unlock key of the client and ends the sessions they signed in. Workers sign in with their PIN and can set up a key again only where it is switched on."})
						}
						<p class="m-0 text-sm text-muted-foreground">Platform administrators only. A locked setting is the client's for every application: an existing override of it is kept and not applied until the lock is lifted.</p>
						for _, m := range v.Overrides.memberOptions() {
							@kit.Checkbox(kit.CheckboxProps{ID: "field-lock-" + m.Value, Name: "locked", Value: m.Value, Checked: v.Overrides.Locked[fieldidentity.PolicyMember(m.Value)], Label: m.Label})
						}
					</div>
				}
				<div class="mt-4 flex justify-end">
					if v.Overrides.ConfirmRevoke {
						@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Variant: kit.LegacyDangerOutline, Icon: "lock"}) {
							Lock and revoke keys
						}
					} else {
						@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Icon: "lock"}) {
							Save locks
						}
					}
				</div>
			</form>
		} else if len(v.Overrides.Locked) > 0 {
			<p class="mt-2 text-sm text-muted-foreground">
				Locked for applications:
				for _, m := range v.Overrides.memberOptions() {
					if v.Overrides.Locked[fieldidentity.PolicyMember(m.Value)] {
						<span class="ml-1">{ m.Label }.</span>
					}
				}
			</p>
		}
	</div>
}
