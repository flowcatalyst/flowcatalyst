package pages

import "strconv"

// RolePickItem is one role in a RolePicker.
type RolePickItem struct {
	// Value is the role name: posted under the picker's Name and shown as the
	// code line.
	Value string
	// Key is the id-safe token of the row's checkbox id, unique in the list.
	Key string
	// Name is the display name (the role's code when it has none).
	Name string
	// Selected is whether the role is assigned at render time.
	Selected bool
	// Locked is a role above the caller (see PickerItem.Locked).
	Locked bool
}

// RolePickerProps configures RolePicker: the DualPicker with the SPA's role
// wording ("Available Roles", "Selected Roles (N)", ROLE_ABOVE_USER_HINT).
type RolePickerProps struct {
	ID, Name, Signal, FilterSignal, ItemIDPrefix string
	Items                                        []RolePickItem
	// Hidden counts roles left out because their application is not enabled
	// for the subject; 0 for no note. HiddenNote overrides the note's text
	// (after the count) for a subject that is not a user.
	Hidden     int
	HiddenNote string
}

const (
	// rolePickerLockedHint is the SPA's ROLE_ABOVE_USER_HINT.
	rolePickerLockedHint = "This role holds permissions you do not have, so you cannot add or remove it."
	rolePickerHiddenNote = "hidden because their application isn't enabled for this user. Add the application under Application Access to make them available here."
)

func (p RolePickerProps) picker() PickerProps {
	items := make([]PickerItem, len(p.Items))
	for i, it := range p.Items {
		items[i] = PickerItem{Value: it.Value, Key: it.Key, Name: it.Name, Code: it.Value, Selected: it.Selected, Locked: it.Locked}
	}
	pp := PickerProps{
		ID: p.ID, Name: p.Name, Signal: p.Signal, FilterSignal: p.FilterSignal, ItemIDPrefix: p.ItemIDPrefix, Items: items,
		AvailableTitle: "Available Roles", SelectedTitle: "Selected Roles", FilterPlaceholder: "Filter roles...",
		NoneFoundText: "No roles found", NoneSelectedText: "No roles selected", LockedHint: rolePickerLockedHint,
	}
	if p.Hidden > 0 {
		s := strconv.Itoa(p.Hidden) + " role"
		if p.Hidden != 1 {
			s += "s"
		}
		pp.HiddenNote = s + " " + cmpOrString(p.HiddenNote, rolePickerHiddenNote)
	}
	return pp
}

// RolePicker is the dual-pane role picker of the SPA's Manage Roles dialog.
templ RolePicker(p RolePickerProps) {
	@DualPicker(p.picker())
}

// appPicker is the dual picker with the SPA's application wording ("Available
// Applications", "Selected Applications (N)") posting applicationIds.
func appPicker(id, signal, filterSignal, prefix string, items []PickerItem) PickerProps {
	return PickerProps{
		ID: id, Name: "applicationIds", Signal: signal, FilterSignal: filterSignal, ItemIDPrefix: prefix, Items: items,
		AvailableTitle: "Available Applications", SelectedTitle: "Selected Applications", FilterPlaceholder: "Filter applications...",
		NoneFoundText: "No applications found", NoneSelectedText: "No applications selected",
	}
}
