package pages

import (
	"strconv"
	"time"

	"github.com/flowcatalyst/framework/go/ui/kit"
)

const (
	// fwCountExpr counts the ticked rows into $fwSel and sets the select-all
	// box to checked / mixed / clear. It sits on the table region (change
	// bubbles), not on every row's box.
	fwCountExpr = "const b = [...document.querySelectorAll('#field-workers-rows input[name=ids]')]; const n = b.filter(c => c.checked).length; $fwSel = n; const h = document.getElementById('fw-select-all'); if (h) { h.checked = n > 0 && n === b.length; h.indeterminate = n > 0 && n < b.length }"
	// fwAllExpr is the select-all box: tick or clear every row on the page.
	fwAllExpr = "document.querySelectorAll('#field-workers-rows input[name=ids]').forEach(c => c.checked = el.checked); " + fwCountExpr
	// fwPrintForm is the form of the "Print badges" confirmation; the row
	// boxes belong to it through their form attribute.
	fwPrintForm = "fw-print-badges-form"
	// fwPrintExpr prints the sheet of badge cards: a copy of the cards goes
	// to a node directly under <body> and the print styles show only that
	// node; the copy (and its tokens) is removed when printing ends.
	fwPrintExpr = "const c = document.getElementById('fw-print-sheet').cloneNode(true); c.removeAttribute('id'); const root = document.createElement('div'); root.id = 'fw-print-root'; root.appendChild(c); document.body.appendChild(root); document.documentElement.classList.add('fw-printing'); window.addEventListener('afterprint', () => { root.remove(); document.documentElement.classList.remove('fw-printing') }, {once: true}); window.print()"
)

func (v fieldWorkersView) columns() []kit.DataColumn {
	cols := []kit.DataColumn{
		{Label: "Worker"}, {Label: "Name"}, {Label: "Status"}, {Label: "Lock"}, {Label: "Apps"}, {Label: "Last sign-in"}, {Label: "Created"},
		{Label: "Actions", Class: "w-px"},
	}
	if v.CanManage {
		cols = append([]kit.DataColumn{{Label: "Print", Class: "w-px"}}, cols...)
	}
	return cols
}

func (v fieldWorkersView) empty() *kit.EmptyStateProps {
	if len(v.Rows) > 0 {
		return nil
	}
	switch {
	case v.Client == "":
		return &kit.EmptyStateProps{Message: "Select a client to view its field workers."}
	case v.filtered():
		return &kit.EmptyStateProps{Message: "No field workers match.", Status: true, ClearHref: v.clearURL()}
	}
	return &kit.EmptyStateProps{Message: "No field workers for this client yet."}
}

func (v fieldWorkersView) clientSelect() kit.FilterSelectProps {
	return kit.FilterSelectProps{Name: fieldClientParam, Label: "Client", Placeholder: "Select a client", Options: v.ClientOptions, Selected: v.Client, AutoSubmit: true}
}

func (v fieldWorkersView) toolbar() kit.TableToolbarProps {
	clear := ""
	if v.filtered() {
		clear = v.clearURL()
	}
	hidden := append(v.Query.hidden(), kit.HiddenField{Name: fieldClientParam, Value: v.Client})
	return kit.TableToolbarProps{
		ID: fieldWorkersForm, Action: fieldWorkersPath, SearchPlaceholder: "Search name or worker code (starts with)", SearchValue: v.Query.Q,
		ClearHref: clear, ClearAttrs: templ.Attributes{"data-on:click__prevent": kit.ClearFilters},
		ActiveFilterCount: v.filterCount(), Hidden: hidden,
		SearchAttrs: templ.Attributes{"data-on:input__debounce.300ms": fieldWorkersLive},
		FormAttrs:   templ.Attributes{"data-on:submit": fieldWorkersLive},
		Filters:     fieldWorkersFilters(v),
	}
}

func (v fieldWorkersView) pager() kit.PaginatorProps {
	return kit.PaginatorProps{
		ID: "field-workers-pager", Page: v.Page, Pages: v.Pages, Total: v.Total, Rows: v.Query.Rows, RowsOptions: fieldWorkerList.rows,
		Noun: "field workers", HrefPattern: v.Query.pagePattern(), FormID: fieldWorkersForm,
		LinkAttrs: templ.Attributes{"data-on:click__prevent": liveLink},
	}
}

func (v fieldWorkersView) newHref() string {
	return fieldWorkersPath + "/new?" + fieldClientParam + "=" + v.Client
}

templ fieldWorkersPage(v fieldWorkersView) {
	<div data-signals={ v.drawerSignals() }>
		@kit.PageHeader(kit.PageHeaderProps{
			Title:    "Field Workers",
			Subtitle: "Drivers, pickers and yard staff who sign in to a client's field apps with a worker code and PIN. A separate population from platform users and portal users.",
			Actions:  fieldWorkersActions(v),
		})
		<form id="field-workers-client" method="get" action={ fieldWorkersPath } class="mb-4 flex flex-wrap items-end gap-3">
			@kit.FilterSelect(v.clientSelect())
			<noscript>
				@kit.Button(kit.ButtonProps{Type: "submit"}) {
					Show
				}
			</noscript>
		</form>
		<div class="fc-card-flush">
			if v.Client != "" {
				@kit.TableToolbar(v.toolbar())
			}
			@fieldWorkersRegion(v)
			if v.Client != "" {
				@kit.Paginator(v.pager())
			}
		</div>
		<p class="mt-2 text-xs text-muted-foreground" role="status" data-text="$fieldCopied"></p>
		<div id={ fwDialogSlot }>
			if v.Dialog != nil {
				@v.Dialog
			}
		</div>
		if v.CanManage {
			@kit.ConfirmDialog(v.confirm(fwSuspendID, "Suspend field worker", "Suspend this field worker? They cannot sign in and every session they have is ended, until they are activated again.", "Suspend", kit.ToneWarn))
			@kit.ConfirmDialog(v.confirm(fwActivateID, "Activate field worker", "Activate this field worker? They can sign in again with their current PIN.", "Activate", kit.ToneDefault))
			@kit.ConfirmDialog(v.confirm(fwUnlockID, "Unlock field worker", "Clear this worker's soft and hard locks and their failed-attempt counter? Their PIN is unchanged.", "Unlock", kit.ToneDefault))
			@kit.ConfirmDialog(v.confirm(fwResetPinID, "Reset PIN", "Set a new temporary PIN for this worker? It is shown to you once, must be changed by the worker at their next sign-in, and every session they have is ended.", "Reset PIN", kit.ToneWarn))
			@kit.ConfirmDialog(v.confirm(fwRevokeID, "Remove application access", "Remove this worker's access to the application? Their sessions in that application are ended.", "Remove", kit.ToneDanger))
			@kit.ConfirmDialog(v.confirm(fwUnlinkID, "Unlink platform user", "Remove the link between this worker and their platform user? Nothing else changes.", "Unlink", kit.ToneWarn))
			@kit.ConfirmDialog(v.confirm(fwBadgeIssueID, "Issue badge", "Issue a printed badge for this worker? The badge is shown once, as a card to print; only its hash is kept.", "Issue badge", kit.ToneDefault))
			@kit.ConfirmDialog(v.confirm(fwBadgeReissueID, "Reissue badge", "Issue a new badge for this worker? Their current badge is cancelled at once and stops signing in. The new badge is shown once, as a card to print.", "Reissue badge", kit.ToneWarn))
			@kit.ConfirmDialog(v.confirm(fwBadgeRevokeID, "Revoke badge", "Revoke this worker's badge? It stops signing in at once. They can still sign in with their PIN.", "Revoke badge", kit.ToneDanger))
			@kit.ConfirmDialog(kit.ConfirmDialogProps{
				ID: fwPrintBadgesID, Action: fieldWorkersPath + "/badges/print", Title: "Print badges",
				Message:      "Issue a new badge for each selected worker and show a sheet to print? A worker who already has a badge loses it: the old badge is cancelled at once and stops signing in. The new badges are shown once, on the sheet.",
				ConfirmLabel: "Issue and print", Tone: kit.ToneWarn,
				FormAttrs: templ.Attributes{"id": fwPrintForm, "data-on:submit": kit.SubmitConfirm},
			})
			@kit.ConfirmDialog(v.confirm(fwDeleteID, "Delete field worker", "Delete this field worker? Their sessions are ended and they can no longer sign in. This cannot be undone.", "Delete", kit.ToneDanger))
		}
		@fieldWorkerDrawer(v.Drawer)
	</div>
}

templ fieldWorkersActions(v fieldWorkersView) {
	if v.CanManage {
		@kit.LegacyButton(kit.LegacyButtonProps{Href: v.newHref(), Icon: "plus", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			New Field Worker
		}
	}
}

templ fieldWorkersFilters(v fieldWorkersView) {
	@kit.FilterSelect(kit.FilterSelectProps{Name: "status", Label: "Status", Placeholder: "All statuses", Options: fieldWorkerStatusOptions, Selected: v.Query.Status, Attrs: templ.Attributes{"data-on:change": fieldWorkersLive}})
	@kit.FilterSelect(kit.FilterSelectProps{Name: fieldTestFacet, Label: "Identity", Placeholder: "All identities", Options: fieldWorkerTestOptions, Selected: v.Test, Attrs: templ.Attributes{"data-on:change": fieldWorkersLive}})
	if len(v.AppOptions) > 0 {
		@kit.FilterSelect(kit.FilterSelectProps{Name: fieldAppFacet, Label: "Application", Placeholder: "All applications", Options: v.AppOptions, Selected: v.App, Attrs: templ.Attributes{"data-on:change": fieldWorkersLive}})
	}
}

// fieldWorkersRegion is the table, what every change patches.
templ fieldWorkersRegion(v fieldWorkersView) {
	<div
		id={ fieldWorkersTable }
		if v.CanManage {
			data-on:change={ fwCountExpr }
		}
	>
		if v.CanManage && v.Client != "" {
			@fieldWorkersBulkBar(v)
		}
		@kit.DataTable(kit.DataTableProps{ID: "field-workers-table", BodyID: "field-workers-rows", Columns: v.columns(), Empty: v.empty()}) {
			for _, row := range v.Rows {
				@kit.TR(kit.TRProps{ID: "fw-" + row.ID}) {
					if v.CanManage {
						@kit.TD(kit.TDProps{}) {
							<input type="checkbox" name="ids" value={ row.ID } form={ fwPrintForm } class="accent-primary" aria-label={ "Select " + row.Code + " to print a badge" }/>
						}
					}
					@kit.TD(kit.TDProps{}) {
						<a href={ templ.SafeURL(row.DetailHref) } class="font-medium text-foreground no-underline hover:underline" data-on:click__prevent={ liveLink }><code class="font-mono text-[13px]">{ row.Code }</code></a>
					}
					@kit.TD(kit.TDProps{}) {
						{ row.Name }
						if row.Email != "" {
							<div class="text-xs text-muted-foreground">{ row.Email }</div>
						}
					}
					@kit.TD(kit.TDProps{}) {
						@fieldWorkerStatusTag(row.Status, row.StatusSeverity)
						if row.NoPin {
							<span title="No PIN has been set: the worker cannot sign in until a PIN reset">
								@kit.Tag(kit.TagProps{Severity: kit.TagInfo, Label: "No PIN"})
							</span>
						}
						@fieldWorkerFlagTags(row.IsTest, row.Supervisor)
					}
					@kit.TD(kit.TDProps{}) {
						if row.Lock != "" {
							<span title={ row.LockTitle }>
								@kit.Tag(kit.TagProps{Severity: row.LockSeverity, Label: row.Lock})
							</span>
							if !row.LockUntil.IsZero() {
								<span class="text-xs text-muted-foreground">
									until{ " " }
									@kit.LocalTime(kit.LocalTimeProps{At: row.LockUntil})
								</span>
							}
						} else {
							<span class="text-muted-foreground">—</span>
						}
					}
					@kit.TD(kit.TDProps{}) {
						@fieldWorkerApps(v.CanManage, row)
					}
					@kit.TD(kit.TDProps{}) {
						@kit.LocalTime(kit.LocalTimeProps{At: row.LastLogin, Empty: "—"})
					}
					@kit.TD(kit.TDProps{}) {
						@kit.LocalTime(kit.LocalTimeProps{At: row.Created, Empty: "—"})
					}
					@kit.RowActions(v.rowActions(row))
				}
			}
		}
	</div>
}

templ fieldWorkerStatusTag(label string, sev kit.TagSeverity) {
	@kit.Tag(kit.TagProps{Severity: sev, Label: label})
}

// fieldWorkerFlagTags marks a test identity (TEST) and a worker who may act as
// other workers on a device (SUPERVISOR).
templ fieldWorkerFlagTags(isTest, supervisor bool) {
	if isTest {
		<span title="A test identity: for app QA. A console sign-in code needs only the manage permission.">
			@kit.Tag(kit.TagProps{Severity: kit.TagWarn, Label: "TEST"})
		</span>
	}
	if supervisor {
		<span title="May act as other workers of the client on a device (after entering their own PIN)">
			@kit.Tag(kit.TagProps{Severity: kit.TagInfo, Label: "SUPERVISOR"})
		</span>
	}
}

// fieldWorkersBulkBar is the selection bar above the table: a select-all box
// for the page and "Print badges" for the ticked rows. It sits in the table
// region, so every change of the table clears the ticks it counts.
templ fieldWorkersBulkBar(v fieldWorkersView) {
	<div id="fw-bulk" class="flex flex-wrap items-center gap-3 border-b border-border px-3 py-2">
		<input type="checkbox" id="fw-select-all" class="accent-primary" aria-label="Select all workers on this page" data-on:change={ fwAllExpr }/>
		<span class="text-sm text-muted-foreground" data-text={ "$" + fwSelSig + " > 0 ? $" + fwSelSig + " + ' selected' : 'Tick workers to print their badges'" }>Tick workers to print their badges</span>
		<button type="button" class="fc-btn fc-btn-outline fc-btn-sm" disabled data-attr:disabled={ "$" + fwSelSig + " === 0" } title="Issue a new badge for each ticked worker and print them; an existing badge is replaced" { confirmTrigger(fwPrintBadgesID, fieldWorkersPath+"/badges/print")... }>
			@kit.Icon(kit.IconProps{Name: "id-card", Class: "size-[1rem]"})
			<span data-text={ "$" + fwSelSig + " > 0 ? 'Print badges (' + $" + fwSelSig + " + ')' : 'Print badges'" }>Print badges</span>
		</button>
		<span class="text-xs text-muted-foreground">Printing issues new badges and cancels the workers' existing ones.</span>
	</div>
}

templ fieldWorkerApps(canManage bool, row fieldWorkerRow) {
	if len(row.Apps) > 0 {
		<div class="flex flex-wrap gap-1">
			for _, a := range row.Apps {
				<span class="inline-flex items-center gap-1 rounded-full border border-border px-2 py-0.5 text-xs" title={ a.Title }>
					{ a.Name }
					if canManage && a.RevokeAction != "" {
						@kit.IconButton(kit.IconButtonProps{Icon: "x", Label: "Remove " + a.Name + " access of " + row.Code, Attrs: confirmTrigger(fwRevokeID, a.RevokeAction)})
					}
				</span>
			}
		</div>
	} else {
		<span title="Not granted any application: the worker cannot sign in to anything">
			@kit.Tag(kit.TagProps{Severity: kit.TagWarn, Label: "No apps"})
		</span>
	}
}

// ── drawer ─────────────────────────────────────────────────────────────
templ fieldWorkerDrawer(d *fieldWorkerDetail) {
	if d != nil {
		@kit.Drawer(d.drawerProps()) {
			@fieldWorkerDrawerBody(*d)
		}
	} else {
		@kit.Drawer(kit.DrawerProps{ID: fwDrawerID, Signal: fwDrawerSig, Label: "Field worker"})
	}
}

templ fieldWorkerDrawerContent(d fieldWorkerDetail) {
	@kit.DrawerContent(d.drawerProps()) {
		@fieldWorkerDrawerBody(d)
	}
}

templ fieldWorkerDrawerBody(d fieldWorkerDetail) {
	@kit.FormSection(kit.FormSectionProps{Title: "Details", Actions: fieldWorkerEditButton(d)}) {
		<div class="fc-detail-grid">
			@kit.DetailField(kit.DetailFieldProps{Label: "Worker code"}) {
				<code>{ d.Code }</code>
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Name", Value: d.Name})
			if d.Email != "" {
				@kit.DetailField(kit.DetailFieldProps{Label: "Email", Value: d.Email})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Status"}) {
				@fieldWorkerStatusTag(d.Status, d.StatusSeverity)
				@fieldWorkerFlagTags(d.IsTest, d.Supervisor)
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Lock"}) {
				if d.Lock != "" {
					<span title={ d.LockTitle }>
						@kit.Tag(kit.TagProps{Severity: d.LockSeverity, Label: d.Lock})
					</span>
					if !d.LockUntil.IsZero() {
						<span class="text-xs text-muted-foreground">
							until{ " " }
							@kit.LocalTime(kit.LocalTimeProps{At: d.LockUntil})
						</span>
					}
				} else {
					Not locked
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "PIN"}) {
				if !d.HasPin {
					Not set: the worker cannot sign in until a PIN reset
				} else if d.PinChangeRequired {
					Set; the worker must change it at their next sign-in
				} else {
					Set
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Failed attempts", Value: strconv.Itoa(d.FailedSinceSuccess)})
			@kit.DetailField(kit.DetailFieldProps{Label: "Last sign-in"}) {
				@kit.LocalTime(kit.LocalTimeProps{At: d.LastLogin, Empty: "Never"})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Created"}) {
				@kit.LocalTime(kit.LocalTimeProps{At: d.Created, Empty: "—"})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Updated"}) {
				@kit.LocalTime(kit.LocalTimeProps{At: d.Updated, Empty: "—"})
			}
		</div>
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Applications", Actions: fieldWorkerGrantButton(d)}) {
		if len(d.Apps) == 0 {
			<p class="m-0 text-sm text-muted-foreground">No applications granted: the worker cannot sign in to anything.</p>
		} else {
			<ul class="m-0 flex list-none flex-col gap-2 p-0">
				for _, a := range d.Apps {
					<li class="flex items-center justify-between gap-2 text-sm">
						<span>
							{ a.Name }
							if a.Code != a.Name {
								<code class="text-xs">{ a.Code }</code>
							}
							<span class="text-xs text-muted-foreground">{ a.Granted }</span>
						</span>
						if d.CanManage {
							@kit.IconButton(kit.IconButtonProps{Icon: "x", Label: "Remove " + a.Name + " access", Attrs: confirmTrigger(fwRevokeID, a.RevokeAction)})
						}
					</li>
				}
			</ul>
		}
	}
	@fieldWorkerLinkSection(d)
	@fieldWorkerBadgeSection(d)
	@fieldWorkerSignInAs(d)
	if actions := d.actions(); len(actions) > 0 {
		@kit.FormSection(kit.FormSectionProps{Title: "Actions"}) {
			<div class="flex flex-col gap-4">
				for _, a := range actions {
					<div class="fc-danger-item">
						<div><strong>{ a.Label }</strong><p>{ a.Hint }</p></div>
						@kit.LegacyButton(kit.LegacyButtonProps{Variant: fieldActionVariant(a), Icon: a.Icon, Attrs: confirmTrigger(a.Dialog, a.Action)}) {
							{ fieldActionButton(a) }
						}
					</div>
				}
			</div>
		}
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Sign-in history"}) {
		@fieldSignInsRegion(d)
	}
}

templ fieldWorkerEditButton(d fieldWorkerDetail) {
	if d.CanManage {
		@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: d.EditHref, Icon: "pencil", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Edit
		}
	}
}

// fieldWorkerLinkSection is the platform user the worker is linked to (audit
// correlation only: it grants nothing) and, to a manager, link / change /
// unlink.
templ fieldWorkerLinkSection(d fieldWorkerDetail) {
	@kit.FormSection(kit.FormSectionProps{Title: "Linked platform user"}) {
		if d.Link == nil {
			<p class="m-0 text-sm text-muted-foreground">Not linked. Linking says this worker and a platform user are the same person, so audit trails can be correlated. It grants nothing on either side.</p>
		} else {
			<div class="fc-detail-grid">
				if d.Link.Name == "" && d.Link.Email == "" {
					@kit.DetailField(kit.DetailFieldProps{Label: "User"}) {
						<span class="text-sm text-muted-foreground">No longer exists</span>
						<code class="text-xs">{ d.Link.ID }</code>
					}
				} else {
					@kit.DetailField(kit.DetailFieldProps{Label: "User", Value: d.Link.Name})
					@kit.DetailField(kit.DetailFieldProps{Label: "Email", Value: d.Link.Email})
				}
			</div>
		}
		if d.LinkHref != "" {
			<div class="mt-3 flex flex-wrap gap-2">
				@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyPrimaryOutline, Href: d.LinkHref, Icon: "link", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
					if d.Link == nil {
						Link platform user
					} else {
						Change
					}
				}
				if d.Link != nil {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "ban", Attrs: confirmTrigger(fwUnlinkID, d.UnlinkAction)}) {
						Unlink
					}
				}
			</div>
		}
	}
}

// fieldWorkerBadgeSection is the worker's badge: the state, and (to a manager)
// issue / reissue / revoke. The token is never shown here: it is shown once, at
// issue.
templ fieldWorkerBadgeSection(d fieldWorkerDetail) {
	@kit.FormSection(kit.FormSectionProps{Title: "Badge"}) {
		if d.Badge == nil {
			<p class="m-0 text-sm text-muted-foreground">No active badge. A badge is a printed QR code the worker scans to sign in (with their PIN, unless the client's policy allows badge-only sign-in on an enrolled device).</p>
			if d.CanManage {
				<div class="mt-3">
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyPrimaryOutline, Icon: "id-card", Attrs: confirmTrigger(fwBadgeIssueID, d.Base+"/badge")}) {
						Issue badge
					}
				</div>
			}
		} else {
			<div class="fc-detail-grid">
				@kit.DetailField(kit.DetailFieldProps{Label: "Badge"}) {
					@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "Active"})
				}
				@kit.DetailField(kit.DetailFieldProps{Label: "Issued"}) {
					@kit.LocalTime(kit.LocalTimeProps{At: d.Badge.Created, Empty: "—"})
				}
				@kit.DetailField(kit.DetailFieldProps{Label: "Last used"}) {
					@kit.LocalTime(kit.LocalTimeProps{At: d.Badge.LastUsed, Empty: "Never"})
				}
			</div>
			if d.CanManage {
				<div class="mt-3 flex flex-wrap gap-2">
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyPrimaryOutline, Icon: "refresh-cw", Attrs: confirmTrigger(fwBadgeReissueID, d.Base+"/badge")}) {
						Reissue badge
					}
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "ban", Attrs: confirmTrigger(fwBadgeRevokeID, d.Base+"/badge/revoke")}) {
						Revoke badge
					}
				</div>
			}
		}
	}
}

// fieldWorkerSignInAs is the "Sign in as…" action, shown only to a caller the
// API would let make a console sign-in code for this worker.
templ fieldWorkerSignInAs(d fieldWorkerDetail) {
	if d.CanSignIn {
		@kit.FormSection(kit.FormSectionProps{Title: "Sign in as this worker"}) {
			<div class="fc-danger-item">
				<div><strong>Sign in as…</strong><p>Make a single-use code (ten minutes) that signs in as this worker in one of their applications, on any device. The sign-in is audited under your name.</p></div>
				@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyPrimaryOutline, Href: d.SignInAs, Icon: "log-in", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
					Sign in as
				}
			</div>
		}
	}
}

templ fieldWorkerGrantButton(d fieldWorkerDetail) {
	if d.CanManage && d.CanGrant {
		@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: d.GrantHref, Icon: "circle-plus", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Grant
		}
	}
}

// fieldSignInsRegion is the paged history; the page links patch only it.
templ fieldSignInsRegion(d fieldWorkerDetail) {
	<div id={ fwSignInsID }>
		@kit.DataTable(kit.DataTableProps{ID: "fw-history-table", BodyID: "fw-history-rows", Columns: []kit.DataColumn{{Label: "Time"}, {Label: "Method"}, {Label: "Actor"}, {Label: "Device"}, {Label: "App"}, {Label: "Outcome"}}, Empty: fieldSignInsEmpty(d)}) {
			for _, s := range d.SignIns {
				@kit.TR(kit.TRProps{}) {
					@kit.TD(kit.TDProps{}) {
						@kit.LocalTime(kit.LocalTimeProps{At: s.At, Empty: "—"})
					}
					@kit.TD(kit.TDProps{}) {
						if s.Method != "" {
							<code class="text-xs">{ s.Method }</code>
						} else {
							—
						}
					}
					@kit.TD(kit.TDProps{}) {
						if s.Actor != "" {
							{ s.Actor }
						} else {
							—
						}
					}
					@kit.TD(kit.TDProps{}) {
						if s.Device != "" {
							<code class="text-xs">{ s.Device }</code>
						} else {
							—
						}
					}
					@kit.TD(kit.TDProps{}) {
						if s.App != "" {
							{ s.App }
						} else {
							—
						}
					}
					@kit.TD(kit.TDProps{}) {
						if s.Success {
							@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "Success"})
						} else {
							<span title={ s.Reason }>
								@kit.Tag(kit.TagProps{Severity: kit.TagDanger, Label: "Failure"})
							</span>
							if s.Reason != "" {
								<span class="text-xs text-muted-foreground">{ s.Reason }</span>
							}
						}
					}
				}
			}
		}
		if d.SignInTotal > 0 {
			<div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
				<span>Page { strconv.Itoa(d.SignInPage) } of { strconv.Itoa(d.SignInPages) } · { strconv.Itoa(d.SignInTotal) } attempts</span>
				<span class="flex gap-3">
					if d.PrevHref != "" {
						<a href={ templ.SafeURL(d.PrevHref) } data-on:click__prevent={ liveLink }>Newer</a>
					}
					if d.NextHref != "" {
						<a href={ templ.SafeURL(d.NextHref) } data-on:click__prevent={ liveLink }>Older</a>
					}
				</span>
			</div>
		}
	</div>
}

func fieldSignInsEmpty(d fieldWorkerDetail) *kit.EmptyStateProps {
	if len(d.SignIns) > 0 {
		return nil
	}
	return &kit.EmptyStateProps{Message: "No sign-in attempts yet."}
}

func fieldActionVariant(a fieldAction) kit.LegacyVariant {
	if a.Destructive {
		return kit.LegacyDangerOutline
	}
	return kit.LegacyPrimaryOutline
}

// fieldActionButton is the button text: the label without its ellipsis.
func fieldActionButton(a fieldAction) string {
	l := []rune(a.Label)
	if n := len(l); n > 0 && l[n-1] == '…' {
		return string(l[:n-1])
	}
	return a.Label
}

// ── dialogs ────────────────────────────────────────────────────────────
templ fieldWorkerFormDialog(f fieldWorkerForm) {
	@kit.FormDialog(f.dialog()) {
		@fieldWorkerFormField(f, "workerCode")
		@fieldWorkerFormField(f, "name")
		@fieldWorkerFormField(f, "email")
		@fieldWorkerFormField(f, "apps")
		@fieldWorkerFormField(f, "isTest")
		if f.MayImpersonate {
			@fieldWorkerFormField(f, "canImpersonate")
		}
	}
}

templ fieldWorkerFormField(f fieldWorkerForm, key string) {
	switch key {
		case "workerCode":
			@kit.Field(f.fieldProps(key, "Worker code", "Unique within the client; stored in upper case (up to 64 characters). Entering an existing code only adds the applications below.", true)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Value: f.WorkerCode, Required: true, Invalid: f.Errs.Fields[key] != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"maxlength": "64", "autofocus": true, "autocomplete": "off"}})
			}
		case "name":
			@kit.Field(f.fieldProps(key, "Name", "", true)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Value: f.Name, Required: true, Invalid: f.Errs.Fields[key] != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"autocomplete": "off"}})
			}
		case "email":
			@kit.Field(f.fieldProps(key, "Email", "Optional.", false)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Type: "email", Value: f.Email, Invalid: f.Errs.Fields[key] != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"autocomplete": "off"}})
			}
		case "apps":
			@kit.Field(f.fieldProps(key, "Applications", "The applications the worker may sign in to.", false)) {
				<div id={ f.id(key) } class="flex flex-col gap-2">
					for n, o := range f.AppChoices {
						<div class="flex items-center gap-2">
							@kit.Checkbox(kit.CheckboxProps{ID: f.id(key) + "-" + strconv.Itoa(n), Name: key, Value: o.Value, Label: o.Label, Checked: fieldContains(f.Apps, o.Value)})
						</div>
					}
					if len(f.AppChoices) == 0 {
						<span class="text-sm text-muted-foreground">There are no active applications you can grant.</span>
					}
				</div>
			}
		case "isTest":
			@kit.Field(f.fieldProps(key, "Test identity", testHelp, false)) {
				@kit.Switch(kit.SwitchProps{ID: f.id(key), Name: key, Value: "true", Checked: f.IsTest})
			}
		case "canImpersonate":
			@kit.Field(f.fieldProps(key, "May act as other workers", impersonateHelp, false)) {
				@kit.Switch(kit.SwitchProps{ID: f.id(key), Name: key, Value: "true", Checked: f.CanImpersonate})
			}
	}
}

func fieldContains(set []string, v string) bool {
	for _, s := range set {
		if s == v {
			return true
		}
	}
	return false
}

templ fieldGrantDialog(f fieldGrantForm) {
	@kit.FormDialog(f.dialog()) {
		@fieldGrantField(f)
	}
}

templ fieldGrantField(f fieldGrantForm) {
	@kit.Field(kit.FieldProps{Label: "Application", For: f.id("app"), Required: true, Error: f.Errs.Fields["app"], ErrorID: f.id("app") + "-err", Attrs: templ.Attributes{"id": f.id("app") + "-field"}}) {
		@kit.Select(kit.SelectProps{ID: f.id("app"), Name: "app", Options: f.Choices, Selected: f.App, Required: true, Invalid: f.Errs.Fields["app"] != "", DescribedBy: f.describedBy()})
	}
}

// fieldPinDialog shows the temporary PIN after a reset, once. It cannot be
// dismissed by Escape or the mask: a close that was not the button reopens it.
// The button closes it and removes it from the page, so the PIN does not
// linger in the DOM.
templ fieldPinDialog(p fieldPinReveal) {
	@kit.Dialog(kit.DialogProps{
		ID:         "fw-pin-reveal",
		Title:      "Temporary PIN",
		Persistent: true,
		Attrs:      templ.Attributes{"open": true, "data-init": "el.removeAttribute('open'); el.showModal()", "data-on:cancel": "evt.preventDefault()", "data-on:close": "el.dataset.saved || el.showModal()"},
		Footer:     fieldPinFooter(),
	}) {
		<div class="flex flex-col gap-3">
			<p class="m-0 text-sm">
				The PIN of <strong>{ p.Code }</strong>
				if p.Name != "" {
					({ p.Name })
				}
				has been reset. Give them this temporary PIN; they must change it at their next sign-in, and every session they had has ended.
			</p>
			<div class="fc-detail-field">
				<span class="fc-field-label">Temporary PIN</span>
				<div class="flex items-center gap-2">
					<code id="fw-pin-value" class="fc-mono-chip text-2xl">{ p.PIN }</code>
					@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy temporary PIN", Attrs: templ.Attributes{"title": "Copy", "data-on:click": fieldCopyExpr("fw-pin-value", "PIN")}})
				</div>
			</div>
			@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: "This PIN will not be shown again. If you lose it, reset the PIN once more."})
		</div>
	}
}

templ fieldPinFooter() {
	@kit.Button(kit.ButtonProps{Icon: "check", Attrs: templ.Attributes{"data-on:click": "const d = el.closest('dialog'); d.dataset.saved = '1'; d.close(); d.remove()"}}) {
		Done
	}
}

const (
	testHelp        = "For app QA: tokens carry test=true, and a console sign-in code needs only the manage permission. Applies to a new worker only when the code is new."
	impersonateHelp = "A supervisor: on a device they can sign in as another worker of the client after entering their own PIN. Needs the field-worker impersonate permission."
)

// ── edit ───────────────────────────────────────────────────────────────
templ fieldEditDialog(f fieldEditForm) {
	@kit.FormDialog(f.dialog()) {
		for _, k := range f.keys() {
			@fieldEditField(f, k)
		}
	}
}

templ fieldEditField(f fieldEditForm, key string) {
	switch key {
		case "name":
			@kit.Field(f.fieldProps(key, "Name", "", true)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Value: f.Name, Required: true, Invalid: f.Errs.Fields[key] != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"autocomplete": "off", "autofocus": true}})
			}
		case "email":
			@kit.Field(f.fieldProps(key, "Email", "Optional. Blank removes it.", false)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Type: "email", Value: f.Email, Invalid: f.Errs.Fields[key] != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"autocomplete": "off"}})
			}
		case "isTest":
			@kit.Field(f.fieldProps(key, "Test identity", testHelp, false)) {
				@kit.Switch(kit.SwitchProps{ID: f.id(key), Name: key, Value: "true", Checked: f.IsTest})
			}
		case "canImpersonate":
			@kit.Field(f.fieldProps(key, "May act as other workers", impersonateHelp+" Clearing it ends the sessions the worker holds as an actor.", false)) {
				@kit.Switch(kit.SwitchProps{ID: f.id(key), Name: key, Value: "true", Checked: f.CanImpersonate})
			}
	}
}

// ── link platform user ─────────────────────────────────────────────────
templ fieldLinkDialog(f fieldLinkFormData) {
	@kit.FormDialog(f.dialog()) {
		@fieldLinkField(f)
	}
}

templ fieldLinkField(f fieldLinkFormData) {
	@kit.Field(kit.FieldProps{Label: "Platform user's email", For: f.id("email"), Description: "The user must be a person (not a service account), active, and able to access this client.", Required: true, Error: f.Errs.Fields["email"], ErrorID: f.id("email") + "-err", Attrs: templ.Attributes{"id": f.id("email") + "-field"}}) {
		@kit.Input(kit.InputProps{ID: f.id("email"), Name: "email", Type: "email", Value: f.Email, Required: true, Invalid: f.Errs.Fields["email"] != "", DescribedBy: f.describedBy(), Attrs: templ.Attributes{"autocomplete": "off", "autofocus": true}})
	}
}

// ── sign in as… ────────────────────────────────────────────────────────
templ fieldSignInAsDialog(f fieldSignInAsForm) {
	@kit.FormDialog(f.dialog()) {
		@fieldSignInAsField(f)
		@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: "The code works once and expires in ten minutes. Using it signs in as the worker in that application, and the sign-in is recorded with your name."})
	}
}

templ fieldSignInAsField(f fieldSignInAsForm) {
	@kit.Field(kit.FieldProps{Label: "Application", For: f.id("app"), Required: true, Error: f.Errs.Fields["app"], ErrorID: f.id("app") + "-err", Attrs: templ.Attributes{"id": f.id("app") + "-field"}}) {
		@kit.Select(kit.SelectProps{ID: f.id("app"), Name: "app", Options: f.Choices, Selected: f.App, Required: true, Invalid: f.Errs.Fields["app"] != "", DescribedBy: f.describedBy()})
	}
}

// fieldSignInCodeDialog shows the console sign-in code, its QR code and its
// expiry countdown, once, on the terms of the enrolment code dialog.
templ fieldSignInCodeDialog(c fieldSignInCodeReveal) {
	@kit.Dialog(kit.DialogProps{
		ID:         fwCodeDialog,
		Title:      "Sign-in code",
		Persistent: true,
		Attrs:      templ.Attributes{"open": true, "data-init": "el.removeAttribute('open'); el.showModal()", "data-on:cancel": "evt.preventDefault()", "data-on:close": "el.dataset.saved || el.showModal()"},
		Footer:     fieldPinFooter(),
	}) {
		<div class="flex flex-col items-center gap-3 text-center">
			<p class="m-0 text-sm">
				Signs in as <strong>{ c.WorkerCode }</strong>
				if c.WorkerName != "" {
					({ c.WorkerName })
				}
				in <strong>{ c.AppCode }</strong>. Scan the QR code or type the code in the app's sign-in-code screen.
			</p>
			@fieldSignInQR(c)
			<div class="flex items-center gap-2">
				<code id="fw-code-value" class="fc-mono-chip text-2xl">{ c.Code }</code>
				@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy sign-in code", Attrs: templ.Attributes{"title": "Copy", "data-on:click": fieldCopyExpr("fw-code-value", "Code")}})
			</div>
			<p class="m-0 text-sm text-muted-foreground">
				Expires in
				<strong data-expires={ c.ExpiresAt.UTC().Format(time.RFC3339) } data-init={ fieldExpiryCountdown() }>{ fieldTime(c.ExpiresAt) }</strong>
			</p>
			@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: "The code works once, and the sign-in is audited under your name. It will not be shown again."})
		</div>
	}
}

// ── badge card(s) ──────────────────────────────────────────────────────

// fieldBadgeDialog shows the issued badge card(s), once, with a Print button.
// Like the PIN dialog it cannot be dismissed by accident and "Done" removes it
// from the page, so the tokens do not stay in the DOM. Only the cards print
// (see fieldBadgeStyle).
templ fieldBadgeDialog(b fieldBadgeReveal) {
	@kit.Dialog(kit.DialogProps{
		ID:         fwBadgeDialogID,
		Title:      b.title(),
		Persistent: true,
		Width:      kit.WidthWide,
		Attrs:      templ.Attributes{"open": true, "data-init": "el.removeAttribute('open'); el.showModal()", "data-on:cancel": "evt.preventDefault()", "data-on:close": "el.dataset.saved || el.showModal()"},
		Footer:     fieldBadgeFooter(),
	}) {
		<div class="flex flex-col gap-3">
			@fieldBadgeStyle()
			if len(b.Cards) == 1 {
				<p class="m-0 text-sm">
					A new badge for <strong>{ b.Cards[0].Code }</strong>
					if b.Cards[0].Name != "" {
						({ b.Cards[0].Name })
					}
					. Print it and give it to the worker.
					if b.Replaced {
						Their previous badge has been cancelled and no longer signs in.
					}
				</p>
			} else {
				<p class="m-0 text-sm">
					{ strconv.Itoa(len(b.Cards)) } new badges. Print the sheet and cut the cards out. Any badge these workers had before has been cancelled and no longer signs in.
				</p>
			}
			@kit.Alert(kit.AlertProps{Variant: kit.AlertWarn, Icon: "triangle-alert", Description: "These badges are shown once. Print them before you press Done: a lost or unprinted badge has to be reissued."})
			<div id="fw-print-sheet" class="fw-sheet">
				for _, c := range b.Cards {
					<div class="fw-card">
						<div class="fw-card-name">{ c.Name }</div>
						<div class="fw-card-code"><code>{ c.Code }</code></div>
						<div class="fw-card-client">{ c.Client }</div>
						@fieldBadgeQR(c)
						<div class="fw-card-token">{ c.Token }</div>
					</div>
				}
			</div>
		</div>
	}
}

templ fieldBadgeFooter() {
	@kit.Button(kit.ButtonProps{Icon: "file", Variant: kit.ButtonOutline, Attrs: templ.Attributes{"data-on:click": fwPrintExpr}}) {
		Print
	}
	@fieldPinFooter()
}

// fieldBadgeStyle is the cards' look on screen and on paper. The print rules
// show only the copy of the sheet that the Print button puts under <body>
// (#fw-print-root): everything else is hidden, so the page, the drawer and the
// dialog never print. The sheet is a two-column grid of cards that do not break
// across pages, on A4.
templ fieldBadgeStyle() {
	<style>
		.fw-sheet { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.75rem; max-height: 55vh; overflow: auto; }
		.fw-card { border: 1px solid var(--border, #ccc); border-radius: 0.5rem; padding: 0.75rem; text-align: center; background: #fff; color: #000; break-inside: avoid; }
		.fw-card-name { font-weight: 600; font-size: 1rem; }
		.fw-card-code code { font-size: 1.25rem; font-weight: 700; }
		.fw-card-client { font-size: 0.8rem; margin-bottom: 0.4rem; }
		.fw-card svg { width: 9rem; height: 9rem; border: 0; border-radius: 0; }
		.fw-card-token { font-family: ui-monospace, monospace; font-size: 0.55rem; word-break: break-all; margin-top: 0.3rem; }
		@media screen { #fw-print-root { display: none; } }
		@media print {
			@page { size: A4; margin: 10mm; }
			html.fw-printing body > *:not(#fw-print-root) { display: none !important; }
			html.fw-printing, html.fw-printing body { background: #fff !important; }
			#fw-print-root { display: block; }
			#fw-print-root .fw-sheet { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6mm; max-height: none; overflow: visible; }
			#fw-print-root .fw-card { border: 0.3mm solid #000; border-radius: 3mm; padding: 5mm; }
			#fw-print-root .fw-card svg { width: 40mm; height: 40mm; }
			#fw-print-root .fw-card-token { font-size: 6.5pt; }
		}
	</style>
}
