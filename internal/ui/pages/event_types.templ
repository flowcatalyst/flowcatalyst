package pages

import "github.com/flowcatalyst/flowcatalyst-go/internal/ui/kit"

var etStatusOptions = []kit.Option{
	{Value: "CURRENT", Label: "Current"},
	{Value: "ARCHIVED", Label: "Archived"},
}

// etFacetLabels are the SPA's MultiSelect labels: field label, placeholder,
// selectedItemsLabel.
var etFacetLabels = map[string][3]string{
	etFacetApp: {"Applications", "All Applications", "{0} apps selected"},
	etFacetSub: {"Subdomains", "All Subdomains", "{0} subdomains selected"},
	etFacetAgg: {"Aggregates", "All Aggregates", "{0} aggregates selected"},
}

func (v etView) facetProps(name string) kit.MultiSelectProps {
	l := etFacetLabels[name]
	return kit.MultiSelectProps{
		ID:          "et-filter-" + name,
		Name:        name,
		Label:       l[0],
		Options:     v.Facets[name],
		Selected:    v.Query.facet(name),
		Placeholder: l[1],
		ManyLabel:   l[2],
		EmptyText:   "No options",
		OptionAttrs: templ.Attributes{"data-on:change": etLiveGet},
	}
}

func (v etView) FilterCount() int {
	n := len(v.Query.Facets)
	if v.Query.Status != "" {
		n++
	}
	return n
}

func (v etView) toolbar() kit.TableToolbarProps {
	clear := ""
	if v.Query.filtered() {
		clear = v.Query.clearURL()
	}
	return kit.TableToolbarProps{
		ID:                etFormID,
		Action:            etPath,
		SearchPlaceholder: "Search event types...",
		SearchValue:       v.Query.Q,
		ClearHref:         clear,
		ClearAttrs:        templ.Attributes{"data-on:click__prevent": kit.ClearFilters},
		ActiveFilterCount: v.FilterCount(),
		Hidden:            v.Query.hidden(),
		SearchAttrs:       templ.Attributes{"data-on:input__debounce.300ms": etLiveGet},
		FormAttrs:         templ.Attributes{"data-on:submit": etLiveGet},
		Filters:           etFilters(v),
	}
}

func (v etView) pager() kit.PaginatorProps {
	return kit.PaginatorProps{
		ID: "et-pager", Page: v.Page, Pages: v.Pages, Total: v.Total, Rows: v.Query.Rows,
		RowsOptions: etList.rows, Noun: "event types", HrefPattern: v.Query.pagePattern(), FormID: etFormID,
		LinkAttrs: templ.Attributes{"data-on:click__prevent": liveLink},
	}
}

func (v etView) empty() *kit.EmptyStateProps {
	if len(v.Rows) > 0 {
		return nil
	}
	e := &kit.EmptyStateProps{Message: "No event types found", Status: true}
	if v.Query.filtered() {
		e.ClearHref = v.Query.clearURL()
	}
	return e
}

// exportURL is the export of the view (every matching event type, not
// only the page shown).
func (v etView) exportURL() string {
	q := v.Query
	q.Page = 1
	if enc := q.values().Encode(); enc != "" {
		return etPath + "/export?" + enc
	}
	return etPath + "/export"
}

func (v etView) drawerSignals() string {
	if v.Drawer == nil {
		return "{" + etDrawerSig + ": ''}"
	}
	return "{" + etDrawerSig + ": '" + kit.ID(v.Drawer.ID) + "'}"
}

templ etPage(v etView) {
	<div data-signals={ v.drawerSignals() }>
		@kit.PageHeader(kit.PageHeaderProps{
			Title:    "Event Types",
			Subtitle: "Manage event type definitions and schemas",
			Actions:  etActions(v),
		})
		@kit.Alert(kit.AlertProps{
			Icon:        "info",
			Title:       "New UI preview",
			Description: "This page is served by the new server-rendered UI. The current UI has the same page under Event Types.",
			Class:       "mb-4",
		})
		<div class="fc-card-flush">
			@kit.TableToolbar(v.toolbar())
			@etTable(v)
			@kit.Paginator(v.pager())
		</div>
		<div id={ etDialogSlot }>
			if v.Dialog != nil {
				@v.Dialog
			}
		</div>
		@etConfirmDialogs(v.Perms)
		@etDrawer(v.Drawer)
	</div>
}

// etActions are the SPA's header buttons, each shown only when the user may
// use it (Export Schemas also only when the view has a CURRENT schema).
templ etActions(v etView) {
	<div id="et-actions" class="flex flex-wrap items-center gap-2">
		if v.HasSchemas {
			@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyOutline, Href: v.exportURL(), Icon: "download", Attrs: templ.Attributes{"download": "event-schemas.zip"}}) {
				Export Schemas
			}
		}
		if v.Perms.Sync {
			// The SPA syncs at once (no confirmation), showing the button busy.
			<form method="post" action={ etPath + "/sync-platform" } data-on:submit={ kit.SubmitForm } data-indicator="etSyncBusy">
				@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Variant: kit.LegacySecondary, Icon: "refresh-cw", Attrs: templ.Attributes{"data-attr:disabled": "$etSyncBusy", "data-attr:aria-busy": "$etSyncBusy ? 'true' : 'false'"}}) {
					Sync Platform Events
				}
			</form>
		}
		if v.Perms.Create {
			@kit.LegacyButton(kit.LegacyButtonProps{Href: etPath + "/new", Icon: "plus", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
				Create Event Type
			}
		}
	</div>
}

templ etFilters(v etView) {
	@kit.MultiSelect(v.facetProps(etFacetApp))
	@kit.MultiSelect(v.facetProps(etFacetSub))
	@kit.MultiSelect(v.facetProps(etFacetAgg))
	@kit.FilterSelect(kit.FilterSelectProps{
		Name:        "status",
		Label:       "Status",
		Placeholder: "All Statuses",
		Options:     etStatusOptions,
		Selected:    v.Query.Status,
		Attrs:       templ.Attributes{"data-on:change": etLiveGet},
	})
}

func etColumns() []kit.DataColumn {
	return []kit.DataColumn{
		{Label: "Code"},
		{Label: "Name"},
		{Label: "Description"},
		{Label: "Schemas"},
		{Label: "Status"},
		{Label: "Actions", Class: "w-px"},
	}
}

templ etTable(v etView) {
	@kit.DataTable(kit.DataTableProps{ID: "et-table", BodyID: "et-rows", Columns: etColumns(), Empty: v.empty()}) {
		for _, row := range v.Rows {
			@kit.TR(kit.TRProps{ID: "et-" + row.ID}) {
				@kit.TD(kit.TDProps{}) {
					<a href={ row.DetailHref } class="no-underline" data-on:click__prevent={ liveLink } aria-label={ "View " + row.Code }>
						@kit.CodeChips(kit.CodeChipsProps{Code: row.Code})
					</a>
				}
				@kit.TD(kit.TDProps{}) {
					<a href={ row.DetailHref } class="font-medium text-foreground no-underline hover:underline" data-on:click__prevent={ liveLink }>{ row.Name }</a>
				}
				@kit.TD(kit.TDProps{Class: "text-[13px] text-muted-foreground"}) {
					if row.Description != "" {
						<span class="block max-w-[250px] truncate" title={ row.Description }>{ row.Description }</span>
					} else {
						—
					}
				}
				@kit.TD(kit.TDProps{}) {
					<div class="flex flex-wrap gap-1">
						for _, sv := range row.Versions {
							<span title={ sv.Status }>
								@kit.Tag(kit.TagProps{Severity: sv.Severity, Label: sv.Version})
							</span>
						}
						if len(row.Versions) == 0 {
							<span class="text-xs text-muted-foreground italic">No schemas</span>
						}
					</div>
				}
				@kit.TD(kit.TDProps{}) {
					@kit.Tag(kit.TagProps{Severity: row.StatusSeverity, Label: row.Status})
				}
				@kit.RowActions(v.rowActions(row))
			}
		}
	}
}
