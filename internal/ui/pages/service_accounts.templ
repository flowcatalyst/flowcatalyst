package pages

import "github.com/flowcatalyst/flowcatalyst-go/internal/ui/kit"

var saStatusOptions = []kit.Option{
	{Value: "ACTIVE", Label: "Active"},
	{Value: "INACTIVE", Label: "Inactive"},
}

func (v saView) FilterCount() int {
	n := len(v.Query.Facets)
	if v.Query.Status != "" {
		n++
	}
	return n
}

func (v saView) toolbar() kit.TableToolbarProps {
	clear := ""
	if v.Query.filtered() {
		clear = v.Query.clearURL()
	}
	return kit.TableToolbarProps{
		ID: saFormID, Action: saPath, SearchPlaceholder: "Search by name or code...", SearchValue: v.Query.Q,
		ClearHref: clear, ClearAttrs: templ.Attributes{"data-on:click__prevent": kit.ClearFilters},
		ActiveFilterCount: v.FilterCount(), Hidden: v.Query.hidden(),
		SearchAttrs: templ.Attributes{"data-on:input__debounce.300ms": saLiveGet},
		FormAttrs:   templ.Attributes{"data-on:submit": saLiveGet},
		Filters:     saFilters(v),
	}
}

func (v saView) pager() kit.PaginatorProps {
	return kit.PaginatorProps{
		ID: "sa-pager", Page: v.Page, Pages: v.Pages, Total: v.Total, Rows: v.Query.Rows, RowsOptions: saList.rows,
		Noun: "service accounts", HrefPattern: v.Query.pagePattern(), FormID: saFormID,
		LinkAttrs: templ.Attributes{"data-on:click__prevent": liveLink},
	}
}

func (v saView) columns() []kit.DataColumn {
	sortable := func(label, key string) kit.DataColumn {
		return kit.DataColumn{Label: label, Href: v.Query.sortURL(key), Direction: v.Query.direction(key), LinkAttrs: templ.Attributes{"data-on:click__prevent": sortClick}}
	}
	return []kit.DataColumn{
		sortable("Name", "name"), sortable("Code", "code"), {Label: "Auth Type"}, {Label: "Clients"}, {Label: "Status"},
		sortable("Created", "created"), {Label: "Actions", Class: "w-px"},
	}
}

func (v saView) empty() *kit.EmptyStateProps {
	if len(v.Rows) > 0 {
		return nil
	}
	e := &kit.EmptyStateProps{Message: "No service accounts found", Status: true}
	if v.Query.filtered() {
		e.ClearHref = v.Query.clearURL()
	}
	return e
}

func (v saView) drawerSignals() string {
	if v.Drawer == nil {
		return "{" + saDrawerSig + ": ''}"
	}
	return "{" + saDrawerSig + ": '" + kit.ID(v.Drawer.ID) + "'}"
}

func (v saView) clientSelected() string {
	if vals := v.Query.facet(saClientFacet); len(vals) > 0 {
		return vals[0]
	}
	return ""
}

templ saActiveTag(active bool) {
	if active {
		@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "Active"})
	} else {
		@kit.Tag(kit.TagProps{Severity: kit.TagDanger, Label: "Inactive"})
	}
}

templ saPage(v saView) {
	<div data-signals={ v.drawerSignals() }>
		@kit.PageHeader(kit.PageHeaderProps{Title: "Service Accounts", Subtitle: "Manage service accounts and webhook credentials", Actions: saActions(v)})
		@kit.Alert(kit.AlertProps{Icon: "info", Title: "New UI preview", Description: "This page is served by the new server-rendered UI. The current UI has the same page under Service Accounts.", Class: "mb-4"})
		<div class="fc-card-flush">
			@kit.TableToolbar(v.toolbar())
			@saTable(v)
			@kit.Paginator(v.pager())
		</div>
		<div id={ saDialogSlot }>
			if v.Dialog != nil {
				@v.Dialog
			}
		</div>
		@saConfirmDialogs(v.Perms)
		@saDrawer(v.Drawer)
	</div>
}

templ saActions(v saView) {
	if v.Perms.Create {
		@kit.LegacyButton(kit.LegacyButtonProps{Href: saPath + "/new", Icon: "plus", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Add Service Account
		}
	}
}

templ saFilters(v saView) {
	if len(v.Clients.options) > 0 {
		@kit.FilterSelect(kit.FilterSelectProps{Name: saClientFacet, Label: "Client", Placeholder: "All clients", Options: v.Clients.options, Selected: v.clientSelected(), Attrs: templ.Attributes{"data-on:change": saLiveGet}})
	}
	@kit.FilterSelect(kit.FilterSelectProps{Name: "status", Label: "Status", Placeholder: "All statuses", Options: saStatusOptions, Selected: v.Query.Status, Attrs: templ.Attributes{"data-on:change": saLiveGet}})
}

templ saTable(v saView) {
	@kit.DataTable(kit.DataTableProps{ID: "sa-table", BodyID: "sa-rows", Columns: v.columns(), Empty: v.empty()}) {
		for _, row := range v.Rows {
			@kit.TR(kit.TRProps{ID: "sa-" + row.ID}) {
				@kit.TD(kit.TDProps{}) {
					<a href={ row.DetailHref } class="font-medium text-foreground no-underline hover:underline" data-on:click__prevent={ liveLink }>{ row.Name }</a>
				}
				@kit.TD(kit.TDProps{}) {
					<code class="font-mono text-[13px]">{ row.Code }</code>
				}
				@kit.TD(kit.TDProps{}) {
					@kit.Tag(kit.TagProps{Severity: kit.TagSecondary, Label: row.AuthType})
				}
				@kit.TD(kit.TDProps{Class: "text-[13px]"}) {
					{ row.ClientsText }
				}
				@kit.TD(kit.TDProps{}) {
					@saActiveTag(row.Active)
				}
				@kit.TD(kit.TDProps{}) {
					<time datetime={ row.CreatedISO }>{ row.Created }</time>
				}
				@kit.RowActions(v.rowActions(row))
			}
		}
	}
}

templ saDrawer(d *saDetail) {
	if d != nil {
		@kit.Drawer(d.drawerProps()) {
			@saDrawerBody(*d)
		}
	} else {
		@kit.Drawer(kit.DrawerProps{ID: saDrawerID, Signal: saDrawerSig, Label: "Service account", Size: kit.DrawerWide})
	}
}

templ saDrawerContent(d saDetail) {
	@kit.DrawerContent(d.drawerProps()) {
		@saDrawerBody(d)
	}
}

// saDrawerBody mirrors the SPA's ServiceAccountDetailDrawer: information,
// webhook credentials, API access, roles, application access, connections
// and the danger zone.
templ saDrawerBody(d saDetail) {
	@kit.FormSection(kit.FormSectionProps{Title: "Service Account Information", Actions: saEditButton(d)}) {
		<div class="fc-detail-grid">
			@kit.DetailField(kit.DetailFieldProps{Label: "Name", Value: d.Name})
			@kit.DetailField(kit.DetailFieldProps{Label: "Code"}) {
				<code>{ d.Code }</code>
			}
			if d.PrincipalID != "" {
				@kit.DetailField(kit.DetailFieldProps{Label: "Principal ID"}) {
					<code>{ d.PrincipalID }</code>
				}
			}
			if d.OAuthClientID != "" {
				@kit.DetailField(kit.DetailFieldProps{Label: "OAuth Client ID"}) {
					<code>{ d.OAuthClientID }</code>
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Description", Value: d.Description, Span: true})
			@kit.DetailField(kit.DetailFieldProps{Label: "Scope"}) {
				@kit.Tag(kit.TagProps{Severity: d.ScopeSeverity, Label: d.Scope})
			}
			if d.ShowClientAccess {
				@kit.DetailField(kit.DetailFieldProps{Label: "Client Access", Value: d.ClientAccess, Span: true})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Auth Type"}) {
				@kit.Tag(kit.TagProps{Severity: kit.TagSecondary, Label: d.AuthType})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Created", Value: d.Created})
			@kit.DetailField(kit.DetailFieldProps{Label: "Last Used", Value: d.LastUsed})
		</div>
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Webhook Credentials"}) {
		<p class="text-sm text-muted-foreground">Credentials are encrypted and cannot be viewed. You can regenerate them if needed.</p>
		if d.Perms.Update {
			<div class="mt-3 flex flex-col gap-4">
				@poolActionItem("Auth Token (Bearer)", "Replace the bearer token webhook deliveries carry.") {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyOutline, Icon: "refresh-cw", Attrs: confirmTrigger(saRegenTokenDialog, d.ActionBase+"/regenerate-token")}) {
						Regenerate Token
					}
				}
				@poolActionItem("Signing Secret (HMAC-SHA256)", "Replace the secret webhook deliveries are signed with.") {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyOutline, Icon: "refresh-cw", Attrs: confirmTrigger(saRegenSecretDialog, d.ActionBase+"/regenerate-secret")}) {
						Regenerate Secret
					}
				}
			</div>
		} else {
			<p class="mt-2 text-sm text-muted-foreground">Regenerating credentials needs the service-account update permission and anchor scope.</p>
		}
	}
	@kit.FormSection(kit.FormSectionProps{Title: "API Access"}) {
		<p class="text-sm text-muted-foreground">Mint a bearer token with this account's permissions — the same token a client-credentials exchange returns, without needing the client secret. Expires after 1 hour; the mint is audited.</p>
		if d.Perms.Update {
			<div class="mt-3 flex flex-col gap-4">
				@etDangerItem("Bearer Token (1 hour)", "", etWhy(d.Active, "The service account is deactivated."), "sa-mint-why") {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyOutline, Icon: "key-round", Disabled: !d.Active, Attrs: etDangerAttrs(d.Active, saMintDialog, d.ActionBase+"/token", "sa-mint-why")}) {
						Generate Token
					}
				}
			</div>
		} else {
			<p class="mt-2 text-sm text-muted-foreground">Minting a token needs the service-account update permission and anchor scope.</p>
		}
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Roles", Actions: saRolesButton(d)}) {
		if len(d.Roles) == 0 {
			<p class="text-sm text-muted-foreground">No roles assigned to this service account.</p>
		} else {
			@kit.Table(kit.TableProps{Dense: true}) {
				@kit.THead(kit.THeadProps{Caps: true}) {
					@kit.TR(kit.TRProps{Static: true}) {
						@kit.TH(kit.THProps{}) {
							Role
						}
						@kit.TH(kit.THProps{}) {
							Source
						}
						@kit.TH(kit.THProps{}) {
							Assigned
						}
					}
				}
				@kit.TBody(kit.TBodyProps{}) {
					for _, r := range d.Roles {
						@kit.TR(kit.TRProps{}) {
							@kit.TD(kit.TDProps{}) {
								<span class="block font-medium">{ r.Short }</span>
								<span class="block font-mono text-[12px] text-muted-foreground">{ r.Full }</span>
							}
							@kit.TD(kit.TDProps{}) {
								if r.Source != "" {
									@kit.Tag(kit.TagProps{Severity: saSourceSeverity(r.Source), Label: r.Source})
								}
							}
							@kit.TD(kit.TDProps{}) {
								{ r.Assigned }
							}
						}
					}
				}
			}
		}
		if d.RolesNote != "" {
			<p class="mt-2 text-sm text-muted-foreground">{ d.RolesNote }</p>
		}
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Application Access"}) {
		@saAppAccess(d)
	}
	@kit.FormSection(kit.FormSectionProps{Title: "Connections", Actions: saConnectionsAction(d)}) {
		@saConnections(d)
	}
	if d.Perms.Delete {
		@kit.FormSection(kit.FormSectionProps{Title: "Danger Zone", Danger: true}) {
			@poolActionItem("Delete Service Account", "Permanently delete this service account and its credentials. Cannot be undone.") {
				@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "trash-2", Attrs: confirmTrigger(saDeleteDialog, d.ActionBase+"/delete")}) {
					Delete
				}
			}
		}
	}
}

func saSourceSeverity(source string) kit.TagSeverity {
	if source == "MANUAL" {
		return kit.TagInfo
	}
	return kit.TagSecondary
}

templ saEditButton(d saDetail) {
	<div class="flex items-center gap-1">
		@defExportButton(d.ActionBase + "/export")
		if d.Perms.Update {
			@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: d.EditHref, Icon: "pencil", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
				Edit
			}
		}
	</div>
}

templ saRolesButton(d saDetail) {
	if d.Perms.Roles && d.HasPrincipal {
		@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: d.ActionBase + "/roles", Icon: "pencil", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Manage Roles
		}
	}
}

// saAppAccess is the Application Access section: the all-applications switch
// (the application-axis analogue of an anchor) and, while it is off, the
// explicit grants with their pick list.
templ saAppAccess(d saDetail) {
	if !d.HasPrincipal {
		<p class="text-sm text-muted-foreground">This service account has no linked principal, so it has no application access.</p>
	} else if !d.AppsVisible {
		<p class="text-sm text-muted-foreground">{ d.AppsNote }</p>
	} else {
		if d.Perms.AppsWrite {
			<form method="post" action={ d.ActionBase + "/all-applications" } class="flex flex-col gap-1" data-on:change={ kit.SubmitForm }>
				<input type="hidden" name="drawer" data-attr:value={ "$" + saDrawerSig }/>
				@kit.Switch(kit.SwitchProps{ID: "sa-all-apps", Name: "allApplications", Value: "true", Checked: d.AllApplications, Disabled: !d.AllApplications && !d.Perms.GrantAll, Label: "Access to all applications"})
				<p class="text-sm text-muted-foreground">This service account can access every application, present and future.</p>
				if !d.AllApplications && !d.Perms.GrantAll {
					<p class="text-sm text-muted-foreground">Only an all-applications administrator may grant all-applications access.</p>
				}
				<noscript>
					@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Variant: kit.LegacyOutline, Small: true}) {
						Apply
					}
				</noscript>
			</form>
		} else if d.AllApplications {
			@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "All applications"})
		}
		if !d.AllApplications {
			if d.AppPickerOn {
				<div class="mt-3">
					@kit.PickList(d.AppPicker)
				</div>
			} else if len(d.Apps) == 0 {
				<p class="mt-3 text-sm text-muted-foreground">No application access granted to this service account.</p>
			} else {
				<ul class="mt-3 flex flex-col gap-1">
					for _, a := range d.Apps {
						<li><span class="font-medium">{ a.Name }</span> <code class="text-[12px] text-muted-foreground">{ a.Code }</code></li>
					}
				</ul>
			}
		}
	}
}

templ saConnectionsAction(d saDetail) {
	if d.Perms.ConnsCreate {
		@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: connsPath + "/new", Icon: "plus"}) {
			New Connection
		}
	}
}

// saConnections lists the connections that use the account, with the SPA's
// pause and activate.
templ saConnections(d saDetail) {
	if !d.ConnsVisible {
		<p class="text-sm text-muted-foreground">Viewing connections needs permission to view connections.</p>
	} else if len(d.Conns) == 0 {
		<p class="text-sm text-muted-foreground">No connections for this service account.</p>
	} else {
		@kit.Table(kit.TableProps{Dense: true}) {
			@kit.THead(kit.THeadProps{Caps: true}) {
				@kit.TR(kit.TRProps{Static: true}) {
					@kit.TH(kit.THProps{}) {
						Code
					}
					@kit.TH(kit.THProps{}) {
						Name
					}
					@kit.TH(kit.THProps{}) {
						Status
					}
					if d.Perms.ConnsUpdate {
						@kit.TH(kit.THProps{}) {
							Actions
						}
					}
				}
			}
			@kit.TBody(kit.TBodyProps{}) {
				for _, c := range d.Conns {
					@kit.TR(kit.TRProps{}) {
						@kit.TD(kit.TDProps{}) {
							<a href={ c.Href } class="font-mono text-[13px]">{ c.Code }</a>
						}
						@kit.TD(kit.TDProps{}) {
							{ c.Name }
						}
						@kit.TD(kit.TDProps{}) {
							if c.Active {
								@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: c.Status})
							} else {
								@kit.Tag(kit.TagProps{Severity: kit.TagWarn, Label: c.Status})
							}
						}
						if d.Perms.ConnsUpdate {
							@kit.TD(kit.TDProps{}) {
								if c.Active {
									@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyWarnOutline, Small: true, Icon: "pause", Attrs: confirmTrigger(saPauseConnDialog, c.ActionBase+"/pause")}) {
										Pause
									}
								} else {
									<form method="post" action={ c.ActionBase + "/activate" } data-on:submit={ kit.SubmitForm }>
										<input type="hidden" name="drawer" data-attr:value={ "$" + saDrawerSig }/>
										@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Variant: kit.LegacyPrimaryOutline, Small: true, Icon: "play"}) {
											Activate
										}
									</form>
								}
							}
						}
					}
				}
			}
		}
	}
}

// saConfirmDialogs are the SPA's confirmations, one per action, shared by the
// drawer (confirm-dialog.md, "One dialog for many records"). Only the
// actions the user may run are rendered.
templ saConfirmDialogs(perms saPerms) {
	if perms.Update {
		@kit.ConfirmDialog(saConfirm(saRegenTokenDialog, "Regenerate auth token?", "The current auth token is replaced and stops being used immediately. Webhook deliveries from this service account will carry the new token, so any receiving endpoint still configured with the old one will reject them until you update it. The new value is shown once, so copy it before closing.", "Regenerate token", kit.ToneDanger))
		@kit.ConfirmDialog(saConfirm(saRegenSecretDialog, "Regenerate signing secret?", "The current signing secret is replaced and stops being used immediately. Webhook deliveries from this service account will be signed with the new secret, so any receiving endpoint still verifying with the old one will reject them until you update it. The new value is shown once, so copy it before closing.", "Regenerate secret", kit.ToneDanger))
		@kit.ConfirmDialog(saConfirm(saMintDialog, "Generate a bearer token?", "This mints a live bearer token carrying all of this service account's permissions. Anyone holding it can call the API as this account until it expires in 1 hour. Existing tokens are not revoked, and the mint is recorded in the audit log. The new value is shown once, so copy it before closing.", "Generate token", kit.ToneWarn))
	}
	if perms.ConnsUpdate {
		@kit.ConfirmDialog(saConfirm(saPauseConnDialog, "Pause Connection", "Are you sure you want to pause this connection?", "Pause", kit.ToneWarn))
	}
	if perms.Delete {
		@kit.ConfirmDialog(saConfirm(saDeleteDialog, "Delete Service Account", "Are you sure you want to delete this service account? This permanently deletes it including the service account and all webhook credentials, the associated principal and role assignments, and the OAuth client (client_credentials will stop working). This action cannot be undone.", "Delete", kit.ToneDanger))
	}
}

// saCredentialsDialog shows credentials once. The create dialog cannot be
// dismissed by Escape or the mask (the SPA's closable=false): Chrome lets a
// second Escape through a prevented cancel, so a close that was not the
// button reopens it. The others can be dismissed. Every way of closing
// removes the dialog from the page, so the credentials do not linger.
templ saCredentialsDialog(c saCredentials) {
	@kit.Dialog(kit.DialogProps{
		ID:         saCredsID,
		Title:      c.Title,
		Persistent: true,
		Attrs:      saCredentialsAttrs(c.Persistent),
		Footer:     saCredentialsFooter(),
	}) {
		<div class="flex flex-col gap-4">
			@kit.Alert(kit.AlertProps{Icon: "triangle-alert", Variant: kit.AlertDestructive, Description: c.Warning})
			for gi, g := range c.Groups {
				<div class="flex flex-col gap-3">
					if g.Title != "" {
						<div>
							<strong class="block">{ g.Title }</strong>
							<p class="text-sm text-muted-foreground">{ g.Description }</p>
						</div>
					}
					for ii, it := range g.Items {
						@saCredential(saCredID(gi, ii), it)
					}
				</div>
			}
			<p class="text-xs text-muted-foreground" role="status" data-text="$saCopied"></p>
		</div>
	}
}

templ saCredential(id string, it saCredItem) {
	<div class="fc-detail-field">
		<span class="fc-field-label">{ it.Label }</span>
		<div class="flex items-center gap-2">
			<code id={ id } class="fc-mono-chip break-all">{ it.Value }</code>
			@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy " + it.Label, Attrs: templ.Attributes{"title": "Copy", "data-on:click": saCopyExpr(id, it.Label)}})
		</div>
		if it.Help != "" {
			<small class="text-xs text-muted-foreground">{ it.Help }</small>
		}
	</div>
}

templ saCredentialsFooter() {
	@kit.Button(kit.ButtonProps{Icon: "check", Attrs: templ.Attributes{"data-on:click": "const d = el.closest('dialog'); d.dataset.saved = '1'; d.close(); d.remove()"}}) {
		I've saved the credentials
	}
}

// saFormDialogC is the create or edit dialog.
templ saFormDialogC(f saForm) {
	@kit.FormDialog(f.dialog()) {
		<div class="flex flex-col gap-4" data-signals={ f.signals() }>
			if !f.Edit {
				@defImportBar(saFormDialog, saImportDialog, f.Import)
			}
			@saField(f, "name")
			if !f.Edit {
				@saField(f, "code")
			}
			@saField(f, "description")
			@saField(f, "scope")
			@saField(f, "clientIds")
			if !f.Edit {
				@saField(f, "allApplications")
			}
		</div>
	}
	if !f.Edit {
		@defImportDialogC(f.importDialog())
	}
}

templ saField(f saForm, key string) {
	switch key {
		case "name":
			@kit.Field(f.fieldProps(key, "Name", "A human-readable name for this service account", true)) {
				if f.Edit {
					@kit.Input(f.inputProps(key, f.Name, "My Service Account", templ.Attributes{"required": true, "maxlength": "100", "autocomplete": "off", "autofocus": true}))
				} else {
					@kit.Input(f.inputProps(key, f.Name, "My Service Account", templ.Attributes{"required": true, "maxlength": "100", "autocomplete": "off", "autofocus": true, "data-on:blur": saCodeFromName}))
				}
			}
		case "code":
			@kit.Field(f.fieldProps(key, "Code", "Unique identifier (lowercase, alphanumeric with dashes). Example: tms-service", true)) {
				@kit.Input(f.inputProps(key, f.Code, "my-service-account", templ.Attributes{"required": true, "pattern": "[a-z][a-z0-9\\-]*", "title": "Must start with a letter, use only lowercase letters, numbers, and hyphens", "autocomplete": "off", "data-bind:sa-form-code": true}))
			}
		case "description":
			@kit.Field(f.fieldProps(key, "Description", "", false)) {
				@kit.Textarea(kit.TextareaProps{ID: f.id(key), Name: key, Value: f.Description, Placeholder: "Optional description...", Rows: 3, Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key)})
			}
		case "scope":
			@kit.Field(f.fieldProps(key, "Scope", "Determines which clients this service account can access.", true)) {
				@kit.Select(kit.SelectProps{ID: f.id(key), Name: key, Options: saScopeOptions, Selected: cmpOrString(f.Scope, "ANCHOR"), Required: true, Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"data-bind:sa-form-scope": true}})
			}
		case "clientIds":
			<div
				id={ f.id(key) + "-wrap" }
				data-show="$saFormScope !== 'ANCHOR'"
				if !f.clientsShown() {
					style="display: none"
				}
			>
				<div class="flex flex-col gap-1">
					@kit.MultiSelect(kit.MultiSelectProps{
						ID: f.id(key), Name: key, Label: "Client Access", Options: f.ClientOptions, Selected: f.ClientIDs,
						Placeholder: "Select clients...", Chips: true, Search: true, Signal: "saFormClientsQ", EmptyText: "No clients",
						DescribedBy: f.id(key) + "-help",
					})
					<p id={ f.id(key) + "-help" } class="text-sm text-muted-foreground">
						Select which clients this service account can access.
						if !f.CanPickClients {
							Listing clients needs permission to view clients; only the current links are offered.
						}
					</p>
					if f.fieldError(key) != "" {
						<p id={ f.id(key) + "-err" } class="text-sm text-destructive" role="alert">{ f.fieldError(key) }</p>
					}
				</div>
			</div>
		case "allApplications":
			<div id={ f.id(key) + "-field" } class="flex flex-col gap-1">
				@kit.Switch(kit.SwitchProps{ID: f.id(key), Name: key, Value: "true", Checked: f.AllApplications, Disabled: !f.CanGrantAll, Label: "Access to all applications"})
				<p class="text-sm text-muted-foreground">Leave off to start with no application access; grant specific applications from the account's detail view after creating it.</p>
				if !f.CanGrantAll {
					<p class="text-sm text-muted-foreground">Only an all-applications administrator may grant all-applications access.</p>
				}
			</div>
	}
}

// saRolesDialogC is the roles dialog. Locked roles are posted back
// unchanged so saving does not remove them.
templ saRolesDialogC(f saRolesForm) {
	@kit.FormDialog(f.dialog()) {
		for _, name := range f.Locked {
			<input type="hidden" name="roles" value={ name }/>
		}
		@kit.MultiSelect(kit.MultiSelectProps{
			ID: "sa-roles-pick", Name: "roles", Label: "Roles", Options: f.Options, Selected: f.Selected,
			Placeholder: "Select roles...", MaxLabels: 3, Chips: true, Search: true, Signal: "saRolesQ", EmptyText: "No roles found",
		})
		if len(f.Locked) > 0 {
			<div class="flex flex-col gap-1">
				<span class="fc-field-label">Locked roles</span>
				<ul class="flex flex-col gap-1">
					for _, name := range f.Locked {
						<li class="inline-flex items-center gap-2">
							@kit.Icon(kit.IconProps{Name: "lock", Class: "size-[1rem]"})
							<code class="text-[13px]">{ name }</code>
						</li>
					}
				</ul>
				<p class="text-sm text-muted-foreground">These roles hold permissions you do not have, so you cannot add or remove them.</p>
			</div>
		}
	}
}
