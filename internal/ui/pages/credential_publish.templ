package pages

import (
	"strconv"

	"github.com/flowcatalyst/framework/go/ui/kit"
)

// pubFormBlock is the create dialogs' "Publish credentials to Parameter Store"
// control: the checkbox, the path the parameters will get and a custom path
// behind a disclosure.
templ pubFormBlock(b pubBlock) {
	if b.Show {
		<div
			id={ b.ID + "-field" }
			class="flex flex-col gap-2"
			data-signals={ b.signals() }
			if b.ShowWhen != "" {
				data-show={ b.ShowWhen }
			}
			style={ b.hidden() }
		>
			<div class="flex items-center gap-2">
				@kit.Checkbox(kit.CheckboxProps{ID: b.ID, Name: "publishCredentials", Value: "true", Checked: b.On, Label: "Publish credentials to Parameter Store"})
			</div>
			if b.Err != "" {
				<p id={ b.ID + "-err" } class="text-sm text-destructive" role="alert">{ b.Err }</p>
			}
			<p class="text-sm text-muted-foreground">
				if b.Preview.Err != "" {
					{ b.Preview.Err }
				} else if b.live() {
					Parameters are written under
					<code class="fc-mono-chip break-all" data-text={ b.previewExpr() }>{ b.Preview.Static }</code>
				} else {
					Parameters are written under
					<code class="fc-mono-chip break-all">{ b.Preview.Static }</code>
				}
			</p>
			<details open?={ b.Path != "" || b.PathErr != "" }>
				<summary class="cursor-pointer text-sm font-medium">Custom path</summary>
				<div class="mt-2 flex flex-col gap-1">
					@kit.Input(kit.InputProps{ID: b.pathID(), Name: "publishBasePath", Value: b.Path, Placeholder: b.Prefix, Class: "font-mono", Invalid: b.PathErr != "", DescribedBy: b.pathDescribedBy(), Attrs: b.pathAttrs()})
					<p class="text-sm text-muted-foreground">Optional. Replaces the default path. It must start and end with '/' and lie under { b.Prefix }</p>
					if b.PathErr != "" {
						<p id={ b.pathID() + "-err" } class="text-sm text-destructive" role="alert">{ b.PathErr }</p>
					}
				</div>
			</details>
		</div>
	}
}

// pubSectionC is the drawer's "Parameter Store" section.
templ pubSectionC(s pubSection) {
	if s.Show {
		@kit.FormSection(kit.FormSectionProps{Title: "Parameter Store"}) {
			<div id="pub-section" class="flex flex-col gap-3">
				if s.Err != "" {
					<p class="text-sm text-muted-foreground">{ s.Err }</p>
				} else if s.LinkedName != "" {
					<p class="text-sm">Published with service account <a href={ s.LinkedHref } class="font-medium">{ s.LinkedName }</a>.</p>
				} else {
					if !s.On {
						<p class="text-sm text-muted-foreground">Not published</p>
					}
					for _, row := range s.Rows {
						@pubRowC(s, row)
					}
					if !s.On && s.CanChange {
						<div>
							@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyOutline, Href: s.Base + "/publish", Icon: "upload", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
								Publish credentials
							}
						</div>
					}
					if s.On && s.CanChange {
						<div class="flex flex-wrap items-center gap-2">
							if s.Failing {
								<form method="post" action={ s.Base + "/publish/retry" } data-on:submit={ kit.SubmitForm }>
									<input type="hidden" name="drawer" data-attr:value={ "$" + kit.Signal(s.DrawerSig) }/>
									@kit.LegacyButton(kit.LegacyButtonProps{Type: "submit", Variant: kit.LegacyOutline, Icon: "refresh-cw"}) {
										Retry now
									}
								</form>
							}
							@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "trash-2", Attrs: kit.OpenModal(s.stopDialogID())}) {
								Stop publishing
							}
						</div>
						@pubStopDialog(s)
					}
				}
			</div>
		}
	}
}

// pubRowC is one credential: its parameter and reference, each with copy, and
// where publishing it stands.
templ pubRowC(s pubSection, row pubRow) {
	<div class="flex flex-col gap-1 rounded-lg border border-border p-3" data-testid={ "pub-row-" + row.Cred }>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<strong>{ row.Label }</strong>
			<span class="text-sm text-muted-foreground">
				switch row.Kind {
					case pubPublished:
						Published{ " " }
						@kit.LocalTime(kit.LocalTimeProps{At: row.At})
					case pubPublishing:
						Publishing…
					case pubFailing:
						Failing: { row.Err }, retrying at{ " " }
						@kit.LocalTime(kit.LocalTimeProps{At: row.At})
					case pubRemoving:
						Removing…
					case pubUnpublishable:
						Not published: rotate the client secret to publish it
				}
			</span>
		</div>
		<div class="flex items-center gap-2">
			<code class="fc-mono-chip break-all">{ row.Path }</code>
			@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy " + row.Label + " parameter name", Attrs: templ.Attributes{"title": "Copy name", "data-copy": row.Path, "data-on:click": pubCopyExpr}})
		</div>
		<div class="flex items-center gap-2">
			<code class="fc-mono-chip break-all">{ row.Reference }</code>
			@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy " + row.Label + " reference", Attrs: templ.Attributes{"title": "Copy reference", "data-copy": row.Reference, "data-on:click": pubCopyExpr}})
		</div>
		if row.Kind == pubUnpublishable && s.CanChange && s.CanRotate && s.RotateAction != "" {
			<div>
				@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyWarnOutline, Small: true, Icon: "refresh-cw", Attrs: confirmTrigger(s.RotateDialog, s.RotateAction)}) {
					Rotate and publish
				}
			</div>
		}
	</div>
}

// pubStopDialog asks before the parameters are deleted, and names them.
templ pubStopDialog(s pubSection) {
	<dialog id={ kit.ID(s.stopDialogID()) } class="fc-dialog w-[28rem] max-w-[calc(100vw-2rem)]" closedby="any" aria-labelledby={ s.stopDialogID() + "-title" } data-on:click={ kit.LightDismiss }>
		<form method="post" action={ templ.SafeURL(s.Base + "/publish/stop") } data-on:submit={ kit.SubmitConfirm }>
			<div class="fc-dialog-header"><span id={ s.stopDialogID() + "-title" }>Stop publishing?</span></div>
			<div class="fc-dialog-body flex flex-col gap-3 text-subtle-foreground">
				<p>Deletes these { strconv.Itoa(len(s.StopPaths)) } parameters from Parameter Store. The credentials in FlowCatalyst are not changed.</p>
				<ul class="flex flex-col gap-1">
					for _, p := range s.StopPaths {
						<li><code class="fc-mono-chip break-all">{ p }</code></li>
					}
				</ul>
			</div>
			<input type="hidden" name="drawer" data-attr:value={ "$" + kit.Signal(s.DrawerSig) }/>
			<div class="fc-dialog-footer">
				<button type="button" class="fc-btn fc-btn-text" autofocus data-on:click={ kit.CloseDialog }>Cancel</button>
				<button type="submit" class="fc-btn fc-btn-danger">Stop publishing</button>
			</div>
		</form>
	</dialog>
}

// pubEnableDialogC is the "Publish credentials" dialog of a record's drawer.
templ pubEnableDialogC(f pubEnableForm) {
	@kit.FormDialog(f.dialog()) {
		<div class="flex flex-col gap-4">
			<p class="text-sm text-muted-foreground">
				if f.DefaultErr != "" {
					{ f.DefaultErr }
				} else {
					Parameters are written under
					<code class="fc-mono-chip break-all">{ f.Default }</code>
				}
			</p>
			@pubEnableField(f)
		</div>
	}
}

templ pubEnableField(f pubEnableForm) {
	@kit.Field(f.fieldProps()) {
		@kit.Input(kit.InputProps{ID: pubFormDialog + "-path", Name: "publishBasePath", Value: f.Path, Placeholder: f.Prefix, Class: "font-mono", Invalid: f.Errs.Fields["publishBasePath"] != "", DescribedBy: f.describedBy(), Attrs: templ.Attributes{"autocomplete": "off", "autocapitalize": "off", "spellcheck": "false"}})
	}
}
