package pages

import (
	"strconv"

	"github.com/flowcatalyst/flowcatalyst-go/internal/ui/kit"
)

func (v ocView) toolbar() kit.TableToolbarProps {
	clear := ""
	if v.Query.filtered() {
		clear = v.Query.clearURL()
	}
	return kit.TableToolbarProps{
		ID: ocFormID, Action: ocPath, SearchPlaceholder: "Search clients...", SearchValue: v.Query.Q,
		ClearHref: clear, ClearAttrs: templ.Attributes{"data-on:click__prevent": kit.ClearFilters},
		Hidden:      v.Query.hidden(),
		SearchAttrs: templ.Attributes{"data-on:input__debounce.300ms": ocLiveGet},
		FormAttrs:   templ.Attributes{"data-on:submit": ocLiveGet},
	}
}

func (v ocView) pager() kit.PaginatorProps {
	return kit.PaginatorProps{
		ID: "oc-pager", Page: v.Page, Pages: v.Pages, Total: v.Total, Rows: v.Query.Rows, RowsOptions: ocList.rows,
		Noun: "OAuth clients", HrefPattern: v.Query.pagePattern(), FormID: ocFormID,
		LinkAttrs: templ.Attributes{"data-on:click__prevent": liveLink},
	}
}

func (v ocView) columns() []kit.DataColumn {
	sortable := func(label, key string) kit.DataColumn {
		return kit.DataColumn{Label: label, Href: v.Query.sortURL(key), Direction: v.Query.direction(key), LinkAttrs: templ.Attributes{"data-on:click__prevent": sortClick}}
	}
	return []kit.DataColumn{
		sortable("Name", "name"), sortable("Client ID", "clientId"), sortable("Type", "type"), {Label: "Applications"},
		sortable("Status", "status"), sortable("Created", "created"), {Label: "Actions", Class: "w-px"},
	}
}

func (v ocView) empty() *kit.EmptyStateProps {
	if len(v.Rows) > 0 {
		return nil
	}
	e := &kit.EmptyStateProps{Message: "No OAuth clients found", Status: true}
	if v.Query.filtered() {
		e.ClearHref = v.Query.clearURL()
	}
	return e
}

// drawerSignals declares the drawer's record and the copy button's status
// text, which the page's dialogs share.
func (v ocView) drawerSignals() string {
	if v.Drawer == nil {
		return "{" + ocDrawerSig + ": '', ocCopied: ''}"
	}
	return "{" + ocDrawerSig + ": '" + kit.ID(v.Drawer.ID) + "', ocCopied: ''}"
}

templ ocActiveTag(active bool) {
	if active {
		@kit.Tag(kit.TagProps{Severity: kit.TagSuccess, Label: "Active"})
	} else {
		@kit.Tag(kit.TagProps{Severity: kit.TagSecondary, Label: "Inactive"})
	}
}

templ ocHeaderTags(clientType string, active bool) {
	@kit.Tag(kit.TagProps{Severity: ocTypeSeverity(clientType), Label: clientType})
	@ocActiveTag(active)
}

templ ocPage(v ocView) {
	<div data-signals={ v.drawerSignals() }>
		@kit.PageHeader(kit.PageHeaderProps{Title: "OAuth Clients", Subtitle: "Manage OAuth2/OIDC client registrations for applications that use FlowCatalyst as their identity provider.", Actions: ocActions(v)})
		@kit.Alert(kit.AlertProps{Icon: "info", Title: "New UI preview", Description: "This page is served by the new server-rendered UI. The current UI has the same page under OAuth Clients.", Class: "mb-4"})
		<div class="fc-card-flush">
			@kit.TableToolbar(v.toolbar())
			@ocTable(v)
			@kit.Paginator(v.pager())
		</div>
		<div id={ ocDialogSlot }>
			if v.Dialog != nil {
				@v.Dialog
			}
		</div>
		@ocConfirmDialogs(v.Perms)
		@ocDrawer(v.Drawer)
	</div>
}

templ ocActions(v ocView) {
	if v.Perms.Create {
		@kit.LegacyButton(kit.LegacyButtonProps{Href: ocPath + "/new", Icon: "plus", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Add OAuth Client
		}
	}
}

templ ocTable(v ocView) {
	@kit.DataTable(kit.DataTableProps{ID: "oc-table", BodyID: "oc-rows", Columns: v.columns(), Empty: v.empty()}) {
		for _, row := range v.Rows {
			@kit.TR(kit.TRProps{ID: "oc-" + row.ID}) {
				@kit.TD(kit.TDProps{}) {
					<a href={ row.DetailHref } class="font-medium text-foreground no-underline hover:underline" data-on:click__prevent={ liveLink }>{ row.Name }</a>
				}
				@kit.TD(kit.TDProps{}) {
					<code class="font-mono text-[12px]">{ row.ClientID }</code>
				}
				@kit.TD(kit.TDProps{}) {
					@kit.Tag(kit.TagProps{Severity: ocTypeSeverity(row.Type), Label: row.Type})
				}
				@kit.TD(kit.TDProps{}) {
					if len(row.Apps) == 0 {
						<span class="text-muted-foreground">No restrictions</span>
					} else {
						<div class="flex flex-wrap items-center gap-1">
							for _, name := range row.Apps {
								@kit.Tag(kit.TagProps{Severity: kit.TagSecondary, Label: name})
							}
							if row.MoreApps > 0 {
								<span class="text-xs text-muted-foreground">+{ strconv.Itoa(row.MoreApps) } more</span>
							}
						</div>
					}
				}
				@kit.TD(kit.TDProps{}) {
					@ocActiveTag(row.Active)
				}
				@kit.TD(kit.TDProps{}) {
					<time datetime={ row.CreatedISO }>{ row.Created }</time>
				}
				@kit.RowActions(v.rowActions(row))
			}
		}
	}
}

templ ocDrawer(d *ocDetail) {
	if d != nil {
		@kit.Drawer(d.drawerProps()) {
			@ocDrawerBody(*d)
		}
	} else {
		@kit.Drawer(kit.DrawerProps{ID: ocDrawerID, Signal: ocDrawerSig, Label: "OAuth client", Size: kit.DrawerWide})
	}
}

templ ocDrawerContent(d ocDetail) {
	@kit.DrawerContent(d.drawerProps()) {
		@ocDrawerBody(d)
	}
}

templ ocChips(values []string, none string) {
	if len(values) == 0 {
		<span class="text-muted-foreground">{ none }</span>
	} else {
		<div class="flex flex-wrap gap-1">
			for _, v := range values {
				<code class="fc-mono-chip break-all">{ v }</code>
			}
		</div>
	}
}

templ ocTags(values []string, sev kit.TagSeverity, none string) {
	if len(values) == 0 {
		<span class="text-muted-foreground">{ none }</span>
	} else {
		<div class="flex flex-wrap gap-1">
			for _, v := range values {
				@kit.Tag(kit.TagProps{Severity: sev, Label: v})
			}
		</div>
	}
}

// ocDrawerBody mirrors the SPA's OAuthClientDetailDrawer: the configuration,
// the client secret and the activation.
templ ocDrawerBody(d ocDetail) {
	@kit.FormSection(kit.FormSectionProps{Title: "Client Configuration", Actions: ocEditButton(d)}) {
		<div class="fc-detail-grid">
			@kit.DetailField(kit.DetailFieldProps{Label: "Client Name", Value: d.Name})
			@kit.DetailField(kit.DetailFieldProps{Label: "Client ID"}) {
				<div class="flex items-center gap-1">
					<code id="oc-client-id" class="fc-mono-chip break-all">{ d.ClientID }</code>
					@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy Client ID", Attrs: templ.Attributes{"title": "Copy Client ID", "data-on:click": ocCopyExpr("oc-client-id", "Client ID")}})
				</div>
				<p class="text-xs text-muted-foreground" role="status" data-text="$ocCopied"></p>
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Redirect URIs", Span: true}) {
				@ocChips(d.Redirects, "—")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Post-Logout Redirect URIs", Span: true}) {
				@ocChips(d.PostLogout, "No post-logout redirects configured")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Allowed CORS Origins", Span: true}) {
				@ocChips(d.Origins, "No CORS origins configured")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Grant Types"}) {
				@ocTags(d.Grants, kit.TagSecondary, "—")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Default Scopes"}) {
				@ocTags(d.Scopes, kit.TagSecondary, "—")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "PKCE Required"}) {
				if d.PKCE {
					<span class="inline-flex items-center gap-1">
						@kit.Icon(kit.IconProps{Name: "check", Class: "size-[1rem]"})
						Yes
					</span>
				} else {
					<span class="inline-flex items-center gap-1 text-muted-foreground">
						@kit.Icon(kit.IconProps{Name: "x", Class: "size-[1rem]"})
						No
					</span>
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Associated Applications"}) {
				@ocTags(d.Apps, kit.TagInfo, "No application restrictions")
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Portal Owner Client"}) {
				if d.IsPortal {
					{ d.PortalOwner }
				} else {
					<span class="text-muted-foreground">Not a portal client</span>
				}
			}
			if d.IsPortal {
				@kit.DetailField(kit.DetailFieldProps{Label: "Portal App"}) {
					if d.PortalApp != "" {
						{ d.PortalApp }
					} else {
						<span class="text-muted-foreground">Legacy: whole client (no app gate)</span>
					}
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "API Access"}) {
				if d.APIAccess {
					@kit.Tag(kit.TagProps{Severity: kit.TagWarn, Label: "Authority-bearing tokens"})
				} else {
					@kit.Tag(kit.TagProps{Severity: kit.TagSecondary, Label: "Identity tokens only"})
				}
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Created"}) {
				@kit.LocalTime(kit.LocalTimeProps{At: d.Created})
			}
			@kit.DetailField(kit.DetailFieldProps{Label: "Last Updated"}) {
				@kit.LocalTime(kit.LocalTimeProps{At: d.Updated})
			}
		</div>
	}
	if d.Confidential {
		@kit.FormSection(kit.FormSectionProps{Title: "Client Secret", Description: "The client secret is encrypted and cannot be displayed. If you need a new secret, you can rotate it."}) {
			if d.HasOverlap {
				@kit.Alert(kit.AlertProps{Icon: "triangle-alert", Title: "Previous secret still accepted", Description: d.overlapText(), Class: "mb-3"})
			}
			if d.Perms.Rotate {
				<div class="flex flex-col gap-4">
					@poolActionItem("Rotate Secret", "Issue a new secret. The current one keeps working for 24 hours so applications can be updated.") {
						@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyWarnOutline, Icon: "refresh-cw", Attrs: confirmTrigger(ocRotateDialog, d.ActionBase+"/rotate-secret")}) {
							Rotate Secret
						}
					}
					@poolActionItem("Rotate Without Overlap", "Issue a new secret and stop the current one at once. Use this when it may be compromised.") {
						@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "refresh-cw", Attrs: confirmTrigger(ocRotateNowDialog, d.ActionBase+"/rotate-secret-now")}) {
							Rotate Now
						}
					}
					if d.HasOverlap {
						@poolActionItem("Revoke Previous Secret", "End the overlap now: the previous secret stops working immediately.") {
							@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyDangerOutline, Icon: "ban", Attrs: confirmTrigger(ocRevokeDialog, d.ActionBase+"/revoke-previous-secret")}) {
								Revoke Previous Secret
							}
						}
					}
				</div>
			} else {
				<p class="text-sm text-muted-foreground">Rotating the secret needs the regenerate-secret permission and anchor scope.</p>
			}
		}
	}
	if d.Perms.Update {
		@kit.FormSection(kit.FormSectionProps{Title: "Actions"}) {
			if d.Active {
				@poolActionItem("Deactivate Client", "Inactive clients cannot be used to authenticate users.") {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyWarnOutline, Icon: "ban", Attrs: confirmTrigger(ocDeactivateDialog, d.ActionBase+"/deactivate")}) {
						Deactivate
					}
				}
			} else {
				@poolActionItem("Activate Client", "Re-enable this client so applications can authenticate users with it.") {
					@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyPrimaryOutline, Icon: "circle-check", Attrs: confirmTrigger(ocActivateDialog, d.ActionBase+"/activate")}) {
						Activate
					}
				}
			}
		}
	}
}

templ ocEditButton(d ocDetail) {
	if d.Perms.Update {
		@kit.LegacyButton(kit.LegacyButtonProps{Variant: kit.LegacyTextPrimary, Href: d.EditHref, Icon: "pencil", Attrs: templ.Attributes{"data-on:click__prevent": liveLink, "aria-haspopup": "dialog"}}) {
			Edit
		}
	}
}

// ocConfirmDialogs are the SPA's confirmations, one per action, shared by the
// rows and the drawer (confirm-dialog.md, "One dialog for many records"). Only
// the actions the user may run are rendered.
templ ocConfirmDialogs(perms ocPerms) {
	if perms.Update {
		@kit.ConfirmDialog(ocConfirm(ocActivateDialog, "Activate OAuth Client", "Re-enable this client so applications can authenticate users with it?", "Activate", kit.ToneDefault))
		@kit.ConfirmDialog(ocConfirm(ocDeactivateDialog, "Deactivate OAuth Client", "Inactive clients cannot be used to authenticate users. Deactivate this client?", "Deactivate", kit.ToneWarn))
	}
	if perms.Rotate {
		@kit.ConfirmDialog(ocConfirm(ocRotateDialog, "Rotate client secret?", "A new client secret is issued and shown once. The current secret keeps working for a 24-hour overlap so applications can be updated, then stops working. Applications using the old secret will fail to authenticate after that until they are updated. The new value is shown once, so copy it before closing.", "Rotate secret", kit.ToneWarn))
		@kit.ConfirmDialog(ocConfirm(ocRotateNowDialog, "Rotate client secret now?", "A new client secret is issued and shown once. The current secret stops working immediately, with no overlap: applications using it will fail to authenticate until they are updated. The new value is shown once, so copy it before closing.", "Rotate now", kit.ToneDanger))
		@kit.ConfirmDialog(ocConfirm(ocRevokeDialog, "Revoke previous secret?", "The previous secret stops working immediately instead of at the end of its 24-hour overlap. Applications still using it will fail to authenticate.", "Revoke", kit.ToneDanger))
	}
	if perms.Delete {
		@kit.ConfirmDialog(ocConfirm(ocDeleteDialog, "Delete OAuth Client", "Are you sure you want to delete this OAuth client? Applications using this client will no longer be able to authenticate users.", "Delete", kit.ToneDanger))
	}
}

// ocCredentialsDialog shows a secret once. The create dialog cannot be
// dismissed by Escape or the mask (the SPA's closable=false): Chrome lets a
// second Escape through a prevented cancel, so a close that was not the
// button reopens it. The rotation dialog can be dismissed. Every way of
// closing removes the dialog from the page, so the secret does not linger.
templ ocCredentialsDialog(c ocCredentials) {
	@kit.Dialog(kit.DialogProps{
		ID:         ocCredsID,
		Title:      c.Title,
		Persistent: true,
		Attrs:      ocCredentialsAttrs(c.Persistent),
		Footer:     ocCredentialsFooter(),
	}) {
		<div class="flex flex-col gap-4">
			@kit.Alert(kit.AlertProps{Icon: "triangle-alert", Variant: kit.AlertDestructive, Description: c.Warning})
			for i, it := range c.Items {
				@ocCredential(ocCredID(i), it)
			}
			if c.Note != "" {
				<p class="text-sm text-muted-foreground">{ c.Note }</p>
			}
			<p class="text-xs text-muted-foreground" role="status" data-text="$ocCopied"></p>
		</div>
	}
}

templ ocCredential(id string, it ocCredItem) {
	<div class="fc-detail-field">
		<span class="fc-field-label">{ it.Label }</span>
		<div class="flex items-center gap-2">
			<code id={ id } class="fc-mono-chip break-all">{ it.Value }</code>
			@kit.IconButton(kit.IconButtonProps{Icon: "copy", Label: "Copy " + it.Label, Attrs: templ.Attributes{"title": "Copy", "data-on:click": ocCopyExpr(id, it.Label)}})
		</div>
	</div>
}

templ ocCredentialsFooter() {
	@kit.Button(kit.ButtonProps{Icon: "check", Attrs: templ.Attributes{"data-on:click": "const d = el.closest('dialog'); d.dataset.saved = '1'; d.close(); d.remove()"}}) {
		I've copied the secret
	}
}

// ocFormDialogC is the create or edit dialog.
templ ocFormDialogC(f ocForm) {
	@kit.FormDialog(f.dialog()) {
		<div class="flex flex-col gap-4" data-signals={ f.signals() }>
			for _, key := range f.keys() {
				@ocField(f, key)
			}
		</div>
	}
}

// ocMultiField is a multi-select field with its error and help under it.
templ ocMultiField(f ocForm, key string, p kit.MultiSelectProps, help string) {
	<div id={ f.id(key) + "-wrap" } class="flex flex-col gap-1">
		@kit.MultiSelect(p)
		<p id={ f.id(key) + "-help" } class="text-sm text-muted-foreground">{ help }</p>
		if f.fieldError(key) != "" {
			<p id={ f.id(key) + "-err" } class="text-sm text-destructive" role="alert">{ f.fieldError(key) }</p>
		}
	</div>
}

templ ocField(f ocForm, key string) {
	switch key {
		case "clientName":
			@kit.Field(f.fieldProps(key, "Client Name", "A human-readable name for this client", true)) {
				@kit.Input(kit.InputProps{ID: f.id(key), Name: key, Value: f.Name, Placeholder: "e.g., Production SPA, Development Server", Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"required": true, "autocomplete": "off", "autofocus": true}})
			}
		case "clientType":
			@kit.Field(f.fieldProps(key, "Client Type", "Public clients have no secret and always use PKCE; confidential clients are issued a secret, shown once.", true)) {
				@kit.Select(kit.SelectProps{ID: f.id(key), Name: key, Options: ocTypeOptions, Selected: f.Type, Required: true, Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"data-bind:oc-form-type": true}})
			}
		case "redirectUris":
			@kit.Field(f.fieldProps(key, "Redirect URIs", "Allowed callback URLs for OAuth redirects, one per line. Must use HTTPS (except localhost).", !f.Edit)) {
				@kit.Textarea(f.textareaProps(key, f.RedirectText, "https://app.example.com/callback"))
			}
		case "postLogoutRedirectUris":
			@kit.Field(f.fieldProps(key, "Post-Logout Redirect URIs", "Allowed URLs for OIDC RP-Initiated Logout (post_logout_redirect_uri), one per line. Required for session-end redirects — callers must also send id_token_hint.", false)) {
				@kit.Textarea(f.textareaProps(key, f.PostLogoutText, "https://app.example.com/logged-out"))
			}
		case "allowedOrigins":
			@kit.Field(f.fieldProps(key, "Allowed CORS Origins", "Origins allowed to make browser requests to the token endpoint, one per line. Must use HTTPS (except localhost).", false)) {
				@kit.Textarea(f.textareaProps(key, f.OriginsText, "https://app.example.com"))
			}
		case "grantTypes":
			@ocMultiField(f, key, kit.MultiSelectProps{ID: f.id(key), Name: key, Label: "Grant Types *", Options: f.GrantOptions, Selected: f.Grants, Placeholder: "Select grant types", MaxLabels: 3, Chips: true, DescribedBy: f.id(key) + "-help"}, "At least one grant type is required.")
		case "defaultScopes":
			@ocMultiField(f, key, kit.MultiSelectProps{ID: f.id(key), Name: key, Label: "Default Scopes", Options: f.ScopeOptions, Selected: f.Scopes, Placeholder: "Select scopes", MaxLabels: 4, Chips: true, DescribedBy: f.id(key) + "-help"}, "Scopes a login gets when the application asks for none.")
		case "pkceRequired":
			<div id={ f.id(key) + "-field" } class="flex flex-col gap-1">
				if f.Edit {
					@kit.Checkbox(kit.CheckboxProps{ID: f.id(key), Name: key, Value: "true", Checked: f.PKCE, Disabled: f.Type == "PUBLIC", Label: "Require PKCE"})
				} else {
					@kit.Checkbox(kit.CheckboxProps{ID: f.id(key), Name: key, Value: "true", Checked: f.PKCE, Label: "Require PKCE", Attrs: templ.Attributes{"data-attr:disabled": "$ocFormType === 'PUBLIC'"}})
				}
				<p class="text-sm text-muted-foreground" data-show="$ocFormType === 'PUBLIC'" style="display: none">PKCE is always required for public clients</p>
			</div>
		case "applicationIds":
			@ocMultiField(f, key, kit.MultiSelectProps{ID: f.id(key), Name: key, Label: "Associated Applications", Options: f.AppOptions, Selected: f.Apps, Placeholder: "Select applications (optional)", MaxLabels: 3, Chips: true, Search: true, Signal: "ocFormAppsQ", EmptyText: "No applications", DescribedBy: f.id(key) + "-help"}, ocAppsHelp(f))
		case "portalClientId":
			@kit.Field(f.fieldProps(key, "Portal owner client", ocPortalHelp(f), false)) {
				@kit.Select(kit.SelectProps{ID: f.id(key), Name: key, Options: f.ClientOptions, Selected: f.PortalClient, Placeholder: "Not a portal client", Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key), Attrs: templ.Attributes{"data-bind:oc-form-portal": true, "data-on:change": ocPortalChange}})
			}
		case "portalAppId":
			<div id={ f.id(key) + "-field" }>
				if f.PortalClient != "" {
					@kit.Field(kit.FieldProps{Label: "Portal app", For: f.id(key), Description: "Which of the client's portals this OAuth client fronts. Users need a grant for the app to sign in, and the id_token carries its portal_app_code. Manage apps under Portal → Portal Apps.", Error: f.fieldError(key)}) {
						@kit.Select(kit.SelectProps{ID: f.id(key), Name: key, Options: f.PortalAppOptions, Selected: f.PortalApp, Placeholder: "Legacy: whole client (no app)", Invalid: f.fieldError(key) != "", DescribedBy: f.describedBy(key)})
					}
				}
			</div>
		case "apiAccess":
			<div id={ f.id(key) + "-field" } class="flex flex-col gap-1">
				@kit.Checkbox(kit.CheckboxProps{ID: f.id(key), Name: key, Value: "true", Checked: f.APIAccess, Label: "API access (trusted first-party)", Attrs: templ.Attributes{"data-attr:disabled": "$ocFormPortal !== ''"}})
				<p class="text-sm text-muted-foreground">Interactive logins through this client mint authority-bearing access tokens, narrowed to the client's associated applications. Leave off for third-party apps — they should authenticate users from the id_token only. Not available for portal clients.</p>
				if f.fieldError(key) != "" {
					<p id={ f.id(key) + "-err" } class="text-sm text-destructive" role="alert">{ f.fieldError(key) }</p>
				}
			</div>
	}
}
