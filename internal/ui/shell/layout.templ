package shell

import (
	"github.com/flowcatalyst/flowcatalyst-go/internal/ui/assets"
	"github.com/flowcatalyst/flowcatalyst-go/internal/ui/kit"
)

// sessionExpiredExpr: a Datastar action answered 401 (the session expired
// while the page was open) navigates to the login page, returning here after.
// Every other failed request is the flash stack's fallback (kit.FlashStack).
const sessionExpiredExpr = "evt.detail.type === 'error' && evt.detail.argsRaw.status === '401' && window.location.assign('/auth/login?redirect=' + encodeURIComponent(location.pathname + location.search))"

// FlashStackID is the flash stack (kit flash-stack.md) server patches append
// flash messages to; its listener also shows the generic message for a
// Datastar request that failed outside a handler.
const FlashStackID = "flash-stack"

// document is the full HTML page: head with the hashed kit assets, the app
// shell, and the page content in <main>.
templ document(title string, collapsed bool, theme pageTheme, shellProps kit.AppShellProps, flashes []kit.FlashMessageProps, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" { kit.ShellHTMLAttrs(collapsed)... } { kit.ThemeHTMLAttrs(theme.choice, theme.dark)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · FlowCatalyst</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href={ assets.URL("kit.css") }/>
			<script type="module" src={ assets.URL("datastar.js") }></script>
		</head>
		<body data-on:datastar-fetch={ sessionExpiredExpr }>
			@kit.AppShell(shellProps) {
				@kit.FlashStack(kit.FlashStackProps{ID: FlashStackID}) {
					for _, f := range flashes {
						@kit.FlashMessage(f)
					}
				}
				@content
			}
		</body>
	</html>
}

// bareDocument is a page without the app shell (errors before a session exists).
templ bareDocument(title string, theme pageTheme, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" { kit.ThemeHTMLAttrs(theme.choice, theme.dark)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · FlowCatalyst</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href={ assets.URL("kit.css") }/>
			<script type="module" src={ assets.URL("datastar.js") }></script>
		</head>
		<body>
			<main class="mx-auto max-w-xl p-[24px]">
				@content
			</main>
		</body>
	</html>
}

// problem is the content of an error page: a header and a destructive alert.
templ problem(title, message string) {
	@kit.PageHeader(kit.PageHeaderProps{Title: title})
	@kit.Alert(kit.AlertProps{Variant: kit.AlertDestructive, Icon: "triangle-alert", Title: title, Description: message})
}
