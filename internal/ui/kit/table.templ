package kit

import "strconv"

// Class lists from table.md (parts and the users-list per-use overrides).
const (
	tableContainerClasses = "w-full overflow-x-auto"
	tableClasses          = "w-full caption-bottom border-collapse text-sm"
	tableDense            = "[&_td]:py-[0.4rem] [&_td]:px-3 [&_th]:px-3"
	theadClasses          = "[&_tr]:border-b"
	theadCaps             = "bg-subtle [&_th]:h-9 [&_th]:text-[12px] [&_th]:font-semibold [&_th]:tracking-wider [&_th]:text-subtle-foreground [&_th]:uppercase"
	tbodyClasses          = "[&_tr:last-child]:border-0"
	tbodyStriped          = "[&_tr:nth-child(even)]:bg-subtle"
	tfootClasses          = "border-t border-border bg-foreground/5 font-medium [&>tr]:last:border-b-0"
	trClasses             = "border-b border-border transition-colors hover:bg-foreground/5"
	thClasses             = "h-10 px-3 text-left align-middle font-medium whitespace-nowrap text-muted-foreground"
	tdClasses             = "p-3 align-middle whitespace-nowrap"
	captionClasses        = "mt-4 text-sm text-muted-foreground"
	sortLinkClasses       = "inline-flex items-center gap-1 text-inherit no-underline hover:text-foreground"
)

// TableProps mirrors table.md's Props table (the container + <table>).
type TableProps struct {
	// ID goes on the scrolling container (a patch target for the whole table).
	ID      string `json:"id"`
	Caption string `json:"caption"`
	// Dense is the users-list cell padding override.
	Dense bool             `json:"dense"`
	Class string           `json:"class"`
	Attrs templ.Attributes `json:"attrs"`
}

// Table is table.md's container + <table>. Slot: caption-less content
// (THead, TBody, TFoot).
templ Table(p TableProps) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ tableContainerClasses }
	>
		<table
			if p.Dense {
				class={ cx(tableClasses, tableDense, p.Class) }
			} else {
				class={ cx(tableClasses, p.Class) }
			}
			{ p.Attrs... }
		>
			if p.Caption != "" {
				<caption class={ captionClasses }>{ p.Caption }</caption>
			}
			{ children... }
		</table>
	</div>
}

// THeadProps mirrors table.md's table_header.
type THeadProps struct {
	// Caps is the users-list uppercase header on a subtle fill.
	Caps bool `json:"caps"`
}

// THead is table.md's <thead>. Slot: one TR.
templ THead(p THeadProps) {
	<thead
		if p.Caps {
			class={ cx(theadClasses, theadCaps) }
		} else {
			class={ theadClasses }
		}
	>
		{ children... }
	</thead>
}

// TBodyProps mirrors table.md's table_body.
type TBodyProps struct {
	// ID is the rows' patch target (e.g. "pools-rows").
	ID      string           `json:"id"`
	Striped bool             `json:"striped"`
	Attrs   templ.Attributes `json:"attrs"`
}

// TBody is table.md's <tbody>. Slot: rows.
templ TBody(p TBodyProps) {
	<tbody
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Striped {
			class={ cx(tbodyClasses, tbodyStriped) }
		} else {
			class={ tbodyClasses }
		}
		{ p.Attrs... }
	>
		{ children... }
	</tbody>
}

// TFoot is table.md's <tfoot>. Slot: rows.
templ TFoot() {
	<tfoot class={ tfootClasses }>
		{ children... }
	</tfoot>
}

// TRProps mirrors table.md's table_row.
type TRProps struct {
	// Static is the header row override (no hover tint).
	Static bool `json:"static"`
	// Clickable adds cursor-pointer (the name cell must still hold a real link).
	Clickable bool             `json:"clickable"`
	ID        string           `json:"id"`
	Class     string           `json:"class"`
	Attrs     templ.Attributes `json:"attrs"`
}

func (p TRProps) classes() string {
	c := trClasses
	if p.Static {
		c += " hover:bg-transparent"
	}
	if p.Clickable {
		c += " cursor-pointer"
	}
	return cx(c, p.Class)
}

// TR is table.md's <tr>. Slot: cells.
templ TR(p TRProps) {
	<tr
		if p.ID != "" {
			id={ p.ID }
		}
		class={ p.classes() }
		{ p.Attrs... }
	>
		{ children... }
	</tr>
}

// THProps mirrors table.md's table_head.
type THProps struct {
	// Class adds e.g. a fixed width ("w-[20%]").
	Class string           `json:"class"`
	Attrs templ.Attributes `json:"attrs"`
}

// TH is table.md's <th scope="col">. Slot: heading text.
templ TH(p THProps) {
	<th class={ cx(thClasses, p.Class) } scope="col" { p.Attrs... }>
		{ children... }
	</th>
}

// TDProps mirrors table.md's table_cell.
type TDProps struct {
	Colspan int              `json:"colspan"`
	Class   string           `json:"class"`
	Attrs   templ.Attributes `json:"attrs"`
}

// TD is table.md's <td>. Slot: cell content.
templ TD(p TDProps) {
	<td
		class={ cx(tdClasses, p.Class) }
		if p.Colspan > 0 {
			colspan={ strconv.Itoa(p.Colspan) }
		}
		{ p.Attrs... }
	>
		{ children... }
	</td>
}

// SortDirection is a sortable column's state.
type SortDirection string

// Sort directions; "" means the column is not the active sort.
const (
	SortNone SortDirection = ""
	SortAsc  SortDirection = "asc"
	SortDesc SortDirection = "desc"
)

// SortableHeaderProps mirrors data-table.md's server-side sort heading (c):
// a real link (works without script) inside <th aria-sort>.
type SortableHeaderProps struct {
	Label string `json:"label"`
	// Href is the URL that sorts by this column (the next direction).
	Href string `json:"href"`
	// Direction is this column's current sort ("" when another column sorts).
	Direction SortDirection `json:"direction"`
	Class     string        `json:"class"`
	// LinkAttrs go on the <a> (the Datastar `@get` enhancement).
	LinkAttrs templ.Attributes `json:"linkAttrs"`
}

func (p SortableHeaderProps) ariaSort() string {
	switch p.Direction {
	case SortAsc:
		return "ascending"
	case SortDesc:
		return "descending"
	case SortNone:
	}
	return ""
}

// SortableHeader is data-table.md's server-sorted heading: aria-sort on the
// active column, an arrow-up/arrow-down icon, a faded arrow-up-down otherwise.
templ SortableHeader(p SortableHeaderProps) {
	<th
		class={ cx(thClasses, p.Class) }
		scope="col"
		if s := p.ariaSort(); s != "" {
			aria-sort={ s }
		}
	>
		<a href={ p.Href } class={ sortLinkClasses } { p.LinkAttrs... }>
			{ p.Label }
			switch p.Direction {
				case SortAsc:
					@Icon(IconProps{Name: "arrow-up", Class: "size-[0.85rem]"})
				case SortDesc:
					@Icon(IconProps{Name: "arrow-down", Class: "size-[0.85rem]"})
				case SortNone:
					@Icon(IconProps{Name: "arrow-up-down", Class: "size-[0.85rem] opacity-40"})
			}
		</a>
	</th>
}

// EmptyRowProps: the one row a table shows instead of rows (table.md,
// "Empty tables"): a colspan cell holding the empty state.
type EmptyRowProps struct {
	Colspan int             `json:"colspan"`
	Empty   EmptyStateProps `json:"empty"`
}

// EmptyRow is table.md's empty-table row.
templ EmptyRow(p EmptyRowProps) {
	<tr>
		<td colspan={ strconv.Itoa(p.Colspan) }>
			@EmptyState(p.Empty)
		</td>
	</tr>
}

// RowAction is one icon action in a row (PROPOSED: the kit has no row-actions
// spec yet; see docs/ui/README.md "Kit gaps").
type RowAction struct {
	Icon  string `json:"icon"`
	Label string `json:"label"`
	// Href makes the action a link; without it the action is a button and
	// Attrs carry its Datastar handler.
	Href  string           `json:"href"`
	Attrs templ.Attributes `json:"attrs"`
}

// RowActionsProps is the trailing actions cell of a data-table row (PROPOSED).
type RowActionsProps struct {
	Actions []RowAction `json:"actions"`
}

// RowActions renders a right-aligned cell of .fc-icon-btn actions. A click
// inside must not trigger a clickable row: the handlers stop propagation.
templ RowActions(p RowActionsProps) {
	<td class={ cx(tdClasses, "w-px text-right") }>
		<div class="flex items-center justify-end gap-1">
			for _, a := range p.Actions {
				if a.Href != "" {
					<a href={ a.Href } class="fc-icon-btn" title={ a.Label } aria-label={ a.Label } { a.Attrs... }>
						@Icon(IconProps{Name: a.Icon, Class: "size-[1rem]"})
					</a>
				} else {
					<button type="button" class="fc-icon-btn" title={ a.Label } aria-label={ a.Label } { a.Attrs... }>
						@Icon(IconProps{Name: a.Icon, Class: "size-[1rem]"})
					</button>
				}
			}
		</div>
	</td>
}

// DataColumn is one column of a DataTable. A column with an Href is
// sortable (server-side, data-table.md mechanism c).
type DataColumn struct {
	Label     string           `json:"label"`
	Href      string           `json:"href"`
	Direction SortDirection    `json:"direction"`
	Class     string           `json:"class"`
	LinkAttrs templ.Attributes `json:"linkAttrs"`
}

// DataTableProps mirrors data-table.md's Props table: the list-page table
// (dense, caps header, striped rows: the users-list look) with server-sorted
// headings and an empty state.
type DataTableProps struct {
	// ID goes on the scrolling container; BodyID on the <tbody> (the rows'
	// patch target).
	ID      string       `json:"id"`
	BodyID  string       `json:"bodyId"`
	Columns []DataColumn `json:"columns"`
	// Empty, when set, replaces the rows with one EmptyRow spanning all columns.
	Empty *EmptyStateProps `json:"empty"`
}

// DataTable is data-table.md's table part. Slot: the rows (TR + TD/RowActions).
templ DataTable(p DataTableProps) {
	@Table(TableProps{ID: p.ID, Dense: true}) {
		@THead(THeadProps{Caps: true}) {
			@TR(TRProps{Static: true}) {
				for _, c := range p.Columns {
					if c.Href != "" {
						@SortableHeader(SortableHeaderProps{Label: c.Label, Href: c.Href, Direction: c.Direction, Class: c.Class, LinkAttrs: c.LinkAttrs})
					} else {
						@TH(THProps{Class: c.Class}) {
							{ c.Label }
						}
					}
				}
			}
		}
		@TBody(TBodyProps{ID: p.BodyID, Striped: true}) {
			if p.Empty != nil {
				@EmptyRow(EmptyRowProps{Colspan: len(p.Columns), Empty: *p.Empty})
			} else {
				{ children... }
			}
		}
	}
}
